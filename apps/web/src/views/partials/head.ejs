<%
  // Per-page SEO metadata. Every field falls back to a site-wide default, so a page that
  // passes nothing still renders valid metadata — `title` included, which every existing
  // res.render already supplies.
  const _title = typeof title !== 'undefined' && title ? title : '';
  const _pageTitle = _title ? `${_title} — HelloDeploy` : 'HelloDeploy';
  const _description =
    typeof description !== 'undefined' && description
      ? description
      : 'HelloDeploy — self-hosted web application deployment';
  const _siteUrl = typeof siteUrl !== 'undefined' && siteUrl ? siteUrl : '';
  const _path =
    typeof canonical !== 'undefined' && canonical
      ? canonical
      : typeof currentPath !== 'undefined' && currentPath
        ? currentPath
        : '';
  // An absolute canonical needs the origin; without it, emit nothing rather than a
  // relative URL that crawlers treat inconsistently.
  const _canonicalUrl = _siteUrl && _path ? `${_siteUrl}${_path}` : '';
  const _ogTitle = typeof ogTitle !== 'undefined' && ogTitle ? ogTitle : _pageTitle;
  const _ogDescription =
    typeof ogDescription !== 'undefined' && ogDescription ? ogDescription : _description;
  const _ogImagePath =
    typeof ogImage !== 'undefined' && ogImage ? ogImage : '/assets/icons/icon-512.png';
  const _ogImageUrl = _ogImagePath.startsWith('http')
    ? _ogImagePath
    : `${_siteUrl}${_ogImagePath}`;
%>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="<%= _description %>" />
  <title><%= _pageTitle %></title>
  <% if (_canonicalUrl) { %>
  <link rel="canonical" href="<%= _canonicalUrl %>" />
  <% } %>

  <link rel="icon" href="/assets/icons/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="192x192" href="/assets/icons/icon-192.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/assets/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="HelloDeploy" />
  <meta property="og:title" content="<%= _ogTitle %>" />
  <meta property="og:description" content="<%= _ogDescription %>" />
  <meta property="og:image" content="<%= _ogImageUrl %>" />
  <% if (_canonicalUrl) { %>
  <meta property="og:url" content="<%= _canonicalUrl %>" />
  <% } %>
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content="<%= _ogTitle %>" />
  <meta name="twitter:description" content="<%= _ogDescription %>" />
  <meta name="twitter:image" content="<%= _ogImageUrl %>" />
  <meta name="theme-color" content="#ffffff" />

  <!-- Theme applied before stylesheet parse to prevent flash -->
  <script nonce="<%= cspNonce %>">
    (function () {
      var root = document.documentElement;
      var storageKey = 'hd-theme';
      var theme = 'light';

      function syncThemeColor(nextTheme) {
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', nextTheme === 'dark' ? '#0f172a' : '#ffffff');
      }

      function applyTheme(nextTheme, persist) {
        var safeTheme = nextTheme === 'dark' ? 'dark' : 'light';
        root.setAttribute('data-theme', safeTheme);
        root.style.colorScheme = safeTheme;
        syncThemeColor(safeTheme);

        if (persist) {
          try {
            localStorage.setItem(storageKey, safeTheme);
          } catch (e) {}
        }

        try {
          window.dispatchEvent(new CustomEvent('hellodeploy:themechange', { detail: { theme: safeTheme } }));
        } catch (e) {}
      }

      try {
        var storedTheme = localStorage.getItem(storageKey);
        var prefersDark =
          window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (storedTheme === 'dark' || storedTheme === 'light') {
          theme = storedTheme;
        } else if (prefersDark) {
          theme = 'dark';
        }
      } catch (e) {}

      applyTheme(theme, false);
      window.__setHelloDeployTheme = applyTheme;
    })();
  </script>

  <link rel="stylesheet" href="/css/main.css?v=20260713-settings-phase2" />
</head>

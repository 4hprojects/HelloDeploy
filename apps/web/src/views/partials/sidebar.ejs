<% var _path = locals.currentPath || ''; %>
<% var _user = locals.user || null; %>
<nav class="sidebar" id="sidebar" aria-label="Application navigation">
  <ul class="sidebar__nav" role="list">
    <li>
      <a
        href="/dashboard"
        class="sidebar__link"
        <%- _path === '/dashboard' ? 'aria-current="page"' : '' %>
      >
        <%- include('icon', { name: 'dashboard', className: 'sidebar__icon' }) %>
        <span>Dashboard</span>
      </a>
    </li>
    <li>
      <a
        href="/projects"
        class="sidebar__link"
        <%# Inside a project the project's own link is the current page; Projects only marks the section. %>
        <%- ['/projects', '/projects/new'].includes(_path) ? 'aria-current="page"' : _path.startsWith('/projects/') ? 'aria-current="true"' : '' %>
      >
        <%- include('icon', { name: 'projects', className: 'sidebar__icon' }) %>
        <span>Projects</span>
      </a>
    </li>
  </ul>

  <% if (locals.currentProject && currentProject) { %>
  <div class="sidebar__section">
    <p class="sidebar__section-title"><%= currentProject.name %></p>
    <ul class="sidebar__nav" role="list" data-deployment-refresh="project-nav">
      <% (locals.projectNavigation || []).forEach((item) => { %>
        <li>
          <a href="<%= item.href %>"
             class="sidebar__link"
             <%- item.active ? 'aria-current="page"' : '' %>>
            <%- include('icon', { name: item.icon, className: 'sidebar__icon' }) %>
            <span><%= item.label %></span>
            <% if (item.setupMark === 'done') { %>
            <span class="sidebar__setup-mark sidebar__setup-mark--done"><span aria-hidden="true">✓</span><span class="sr-only">, setup step done</span></span>
            <% } else if (item.setupMark === 'next') { %>
            <span class="sidebar__setup-mark sidebar__setup-mark--next">Next<span class="sr-only"> setup step</span></span>
            <% } else if (item.setupMark === 'pending') { %>
            <span class="sidebar__setup-mark sidebar__setup-mark--pending">Pending<span class="sr-only"> custom domain setup</span></span>
            <% } %>
          </a>
        </li>
      <% }) %>
    </ul>
  </div>
  <% } %>

  <% if (_user && (_user.platformRole === 'ADMIN' || _user.platformRole === 'SUPER_ADMIN')) { %>
  <% const _adminCounts = locals.adminPendingCounts || {}; %>
  <div class="sidebar__section">
    <p class="sidebar__section-title">Admin</p>
    <ul class="sidebar__nav" role="list">
      <li>
        <a
          href="/admin"
          class="sidebar__link"
          <%- _path === '/admin' ? 'aria-current="page"' : '' %>
        >
          <%- include('icon', { name: 'dashboard', className: 'sidebar__icon' }) %>
          <span>Overview</span>
        </a>
      </li>
      <li>
        <a
          href="/admin/users"
          class="sidebar__link"
          <%- _path.startsWith('/admin/users') ? 'aria-current="page"' : '' %>
        >
          <%- include('icon', { name: 'users', className: 'sidebar__icon' }) %>
          <span>Users</span>
        </a>
      </li>
      <li>
        <a
          href="/admin/projects"
          class="sidebar__link"
          <%- _path.startsWith('/admin/projects') ? 'aria-current="page"' : '' %>
        >
          <%- include('icon', { name: 'projects', className: 'sidebar__icon' }) %>
          <span>All Projects</span>
        </a>
      </li>
      <li>
        <a
          href="/admin/approval-requests"
          class="sidebar__link"
          <%- _path.startsWith('/admin/approval-requests') ? 'aria-current="page"' : '' %>
        >
          <%- include('icon', { name: 'reviews', className: 'sidebar__icon' }) %>
          <span>Reviews</span>
          <% if (_adminCounts.pendingApprovals > 0) { %>
          <span class="status-badge status-badge--pending sidebar__count"><%= _adminCounts.pendingApprovals %><span class="sr-only"> waiting</span></span>
          <% } %>
        </a>
      </li>
      <li>
        <a
          href="/admin/domains"
          class="sidebar__link"
          <%- _path.startsWith('/admin/domains') ? 'aria-current="page"' : '' %>
        >
          <%- include('icon', { name: 'domain', className: 'sidebar__icon' }) %>
          <span>Domains</span>
          <% if (_adminCounts.pendingDomainApprovals > 0) { %>
          <span class="status-badge status-badge--pending sidebar__count"><%= _adminCounts.pendingDomainApprovals %><span class="sr-only"> waiting</span></span>
          <% } %>
        </a>
      </li>
      <li>
        <a
          href="/admin/audit-events"
          class="sidebar__link"
          <%- _path.startsWith('/admin/audit-events') ? 'aria-current="page"' : '' %>
        >
          <%- include('icon', { name: 'audit', className: 'sidebar__icon' }) %>
          <span>Audit Log</span>
        </a>
      </li>
      <li>
        <a
          href="/admin/server"
          class="sidebar__link"
          <%- _path.startsWith('/admin/server') ? 'aria-current="page"' : '' %>
        >
          <%- include('icon', { name: 'server', className: 'sidebar__icon' }) %>
          <span>Server</span>
        </a>
      </li>
      <% if (locals.builderControlEnabled) { %>
      <li>
        <a
          href="/admin/builder"
          class="sidebar__link"
          <%- _path.startsWith('/admin/builder') ? 'aria-current="page"' : '' %>
        >
          <%- include('icon', { name: 'deploy', className: 'sidebar__icon' }) %>
          <span>Build Service</span>
        </a>
      </li>
      <% } %>
      <% if (locals.learningHubEnabled) { %>
      <li>
        <a
          href="/admin/learning-hub"
          class="sidebar__link"
          <%- _path.startsWith('/admin/learning-hub') ? 'aria-current="page"' : '' %>
        >
          <%- include('icon', { name: 'audit', className: 'sidebar__icon' }) %>
          <span>Learning Hub</span>
        </a>
      </li>
      <% } %>
      <li>
        <a
          href="/admin/ux-metrics"
          class="sidebar__link"
          <%- _path.startsWith('/admin/ux-metrics') ? 'aria-current="page"' : '' %>
        >
          <%- include('icon', { name: 'activity', className: 'sidebar__icon' }) %>
          <span>UX Metrics</span>
        </a>
      </li>
    </ul>
  </div>
  <% } %>

  <div class="sidebar__section">
    <ul class="sidebar__nav" role="list">
      <li>
        <a
          href="/account"
          class="sidebar__link"
          <%- _path === '/account' ? 'aria-current="page"' : '' %>
        >
          <%- include('icon', { name: 'settings', className: 'sidebar__icon' }) %>
          <span>Account</span>
        </a>
      </li>
      <li>
        <form
          method="POST"
          action="/auth/sign-out"
          data-confirm="Are you sure you want to sign out?"
          data-confirm-title="Sign out"
          data-confirm-accept-label="Sign Out"
          data-confirm-pending-label="Signing out…"
          data-confirm-variant="warning"
        >
          <%- include('csrf-field') %>
          <button type="submit" class="sidebar__link sidebar__link--button">
            <%- include('icon', { name: 'logout', className: 'sidebar__icon' }) %>
            <span>Sign Out</span>
          </button>
        </form>
      </li>
    </ul>
  </div>
</nav>

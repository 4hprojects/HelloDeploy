<div class="password-guide">
  <div class="password-meter" aria-hidden="true">
    <span class="password-meter__segment"></span>
    <span class="password-meter__segment"></span>
    <span class="password-meter__segment"></span>
    <span class="password-meter__segment"></span>
  </div>
  <ul class="password-requirements" aria-label="Password requirements" id="password-requirements">

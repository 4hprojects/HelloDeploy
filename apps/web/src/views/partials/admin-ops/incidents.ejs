<% const _incidents = overview.incidents || []; %>
<% if (_incidents.length === 0) { %>
<p class="ops-strip__ok"><span class="ops-dot ops-tone--<%= overview.incidentsAvailable === false ? 'unknown' : 'healthy' %>" aria-hidden="true"></span><%= overview.incidentsAvailable === false ? 'Alert evaluation is not reporting yet: no incidents can be confirmed or ruled out.' : 'No active incidents.' %></p>
<% } else { %>
<h2 class="sr-only">Active incidents</h2>
<ul class="ops-incidents" role="list">
  <% _incidents.forEach((incident) => { %>
  <li class="ops-incident ops-tone--<%= incident.severity %>">
    <span class="ops-incident__severity"><%= incident.severity === 'critical' ? 'Critical' : incident.severity === 'warning' ? 'Warning' : 'Info' %></span>
    <span class="ops-incident__title"><% if (incident.href) { %><a href="<%= incident.href %>"><%= incident.title %></a><% } else { %><%= incident.title %><% } %></span>
    <span class="ops-incident__meta"><%= incident.detail %> · since <%- include('time', { at: incident.firstSeen }) %><% if (incident.occurrences > 1) { %> · <%= incident.occurrences %> occurrences<% } %></span>
    <% if (incident.state === 'acknowledged') { %>
    <span class="ops-incident__ack">Acknowledged<% if (incident.acknowledgedByName) { %> by <%= incident.acknowledgedByName %><% } %></span>
    <% } else if (incident.id) { %>
    <form method="POST" action="/admin/overview/incidents/<%= incident.id %>/acknowledge" class="ops-incident__form" data-ops-ack>
      <%- include('../csrf-field') %>
      <button type="submit" class="button button--secondary button--sm">Acknowledge</button>
    </form>
    <% } %>
  </li>
  <% }) %>
</ul>
<% } %>

<% const _d = overview.deployments; const _q = _d && _d.queue; %>
<% if (!_q) { %>
<p class="ops-empty">Queue unavailable: Redis or BullMQ did not answer. Deployment records below come from the database.</p>
<% } else { %>
<dl class="ops-counts">
  <div><dt>Active</dt><dd><%= _q.active %></dd></div>
  <div><dt>Waiting</dt><dd><%= _q.waiting %></dd></div>
  <div><dt>Delayed</dt><dd><%= _q.delayed %></dd></div>
  <div class="<%= _q.paused ? 'ops-tone--warning' : '' %>"><dt>Queue</dt><dd><%= _q.paused ? 'Paused' : 'Running' %></dd></div>
</dl>
<% if (_q.paused) { %><p class="ops-footnote ops-tone--warning">The queue is paused: jobs wait and nothing is processed until a super administrator resumes it.</p><% } %>
<% } %>
<% if (_d && _d.active && _d.active.length > 0) { %>
<table class="ops-table">
  <caption class="ops-table__caption">In progress</caption>
  <thead><tr><th scope="col">Project</th><th scope="col">Stage</th><th scope="col" class="ops-table__num">Elapsed</th></tr></thead>
  <tbody>
    <% _d.active.forEach((row) => { %>
    <tr><th scope="row"><a href="<%= row.href %>"><%= row.project %> #<%= row.sequence %></a></th><td><span class="ops-state ops-tone--<%= row.stuck ? 'warning' : 'info' %>"><%= row.stageLabel %></span><% if (row.stuck) { %> <span class="ops-muted">possibly stuck</span><% } %></td><td class="ops-table__num"><%= row.elapsed %></td></tr>
    <% }) %>
  </tbody>
</table>
<% } else if (_d && _d.active) { %>
<p class="ops-footnote">No deployment in progress.</p>
<% } %>
<% if (_d && _d.recent && _d.recent.length > 0) { %>
<table class="ops-table">
  <caption class="ops-table__caption">Recent results</caption>
  <thead><tr><th scope="col">Project</th><th scope="col">Result</th><th scope="col">Finished</th></tr></thead>
  <tbody>
    <% _d.recent.forEach((row) => { %>
    <tr><th scope="row"><a href="<%= row.href %>"><%= row.project %> #<%= row.sequence %></a></th><td><span class="ops-state ops-tone--<%= row.tone %>"><%= row.result %></span><% if (row.superseded) { %> <span class="ops-muted">since redeployed</span><% } %></td><td class="ops-table__nowrap"><%- include('time', { at: row.finishedAt }) %></td></tr>
    <% }) %>
  </tbody>
</table>
<% } %>
<% if (_q) { %><p class="ops-footnote"><%= _q.failedRetained %> failed and <%= _q.completedRetained %> completed jobs retained in the queue history. Retained failures are history; open problems are listed under attention.</p><% } %>

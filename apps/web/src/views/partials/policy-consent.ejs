<%
  const _error = typeof error !== 'undefined' ? error : null;
  const _isChecked = typeof isChecked !== 'undefined' && isChecked;
%>
<div class="form-field consent">
  <div class="checkbox-field<% if (_error) { %> checkbox-field--error<% } %>">
    <input
      type="checkbox"
      id="acceptTerms"
      name="acceptTerms"
      value="1"
      class="checkbox-input"
      <% if (_isChecked) { %>checked<% } %>
      aria-required="true"
      aria-describedby="acceptTerms-policies<% if (_error) { %> acceptTerms-error<% } %>"
    />
    <label for="acceptTerms" class="checkbox-label">I agree to the HelloDeploy policies</label>
  </div>
  <ul class="consent__links" id="acceptTerms-policies" role="list">
    <li><a href="/terms" target="_blank" rel="noopener noreferrer">Terms of Service</a></li>
    <li><a href="/privacy" target="_blank" rel="noopener noreferrer">Privacy Policy</a></li>
    <li><a href="/cookies" target="_blank" rel="noopener noreferrer">Cookie Policy</a></li>
    <li><a href="/acceptable-use" target="_blank" rel="noopener noreferrer">Acceptable Use</a></li>
    <li><a href="/legal" target="_blank" rel="noopener noreferrer">Legal Policies</a></li>
  </ul>
  <% if (_error) { %>
  <p class="form-error" id="acceptTerms-error" role="alert"><%= _error %></p>
  <% } %>
</div>

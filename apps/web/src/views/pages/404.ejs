<div class="page-header">
  <h1 class="page-header__title">Page Not Found</h1>
</div>

<div class="card">
  <div class="card__body">
    <p>The page may have moved, the link may be incomplete, or you may not have access to it.</p>
    <p class="mt-4">
      <a href="<%= locals.user ? '/dashboard' : '/' %>" class="button button--primary"><%= locals.user ? 'Go to dashboard' : 'Go to home page' %></a>
      <a href="/docs" class="button button--secondary">Browse documentation</a>
    </p>
    <% if (locals.correlationId) { %><p class="form-hint mt-4">Reference: <code class="code-inline"><%= correlationId %></code></p><% } %>
  </div>
</div>

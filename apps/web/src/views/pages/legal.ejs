<%
  const formatDate = (iso) =>
    new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
%>
<header class="legal-header">
  <h1 class="legal-header__title">Legal</h1>
  <p class="legal-header__lede">The policies for using HelloDeploy, run by <%= legalOperator %>. Each one starts with a short summary.</p>
</header>

<ul class="legal-index" role="list">
  <% legalPolicies.forEach((item) => { %>
    <li class="legal-index__item">
      <h2 class="legal-index__title"><a href="/<%= item.slug %>"><%= item.title %></a></h2>
      <p class="legal-index__summary"><%= item.summary %></p>
      <p class="legal-index__date">Updated <time datetime="<%= item.updated %>"><%= formatDate(item.updated) %></time></p>
    </li>
  <% }) %>
</ul>

<section class="legal-notice" aria-labelledby="legal-notice-title">
  <h2 id="legal-notice-title">Important notice</h2>
  <p>These documents are operational policy drafts for a pilot deployment platform. They should be reviewed by a qualified lawyer before public commercial launch, wider international availability, or use with regulated data.</p>
</section>

<section class="legal-contact" aria-labelledby="legal-contact-title">
  <h2 id="legal-contact-title" class="legal-contact__title">Contact</h2>
  <p>Questions about any policy, privacy requests, and security reports: <a href="mailto:<%= legalContactEmail %>"><%= legalContactEmail %></a>.</p>
</section>

<div class="page-header">
  <h1 class="page-header__title">Server &amp; Queue</h1>
  <p class="page-header__subtitle text-muted text-sm">
    Collected at <%= server.collectedAt ? new Date(server.collectedAt).toLocaleTimeString('en-GB') : '—' %>
    &nbsp;·&nbsp; Uptime: <%= server.uptime?.human ?? '—' %>
  </p>
</div>

<section class="card mb-6" aria-labelledby="platform-release-title">
  <div class="card__header">
    <h2 class="card__title" id="platform-release-title">Platform release</h2>
    <span class="badge <%= server.platformRelease?.matchesExpected === true ? 'badge--success' : 'badge--warning' %>">
      <%= server.platformRelease?.matchesExpected === true ? 'Expected release' : 'Verify release' %>
    </span>
  </div>
  <div class="card__body">
    <dl class="detail-list">
      <dt>Running SHA</dt><dd><code class="code-inline"><%= server.platformRelease?.actualSha || 'Unavailable' %></code></dd>
      <dt>Expected SHA</dt><dd><code class="code-inline"><%= server.platformRelease?.expectedSha || 'Metadata unavailable' %></code></dd>
      <dt>Process started</dt><dd><%= server.platformRelease?.processStartedAt ? new Date(server.platformRelease.processStartedAt).toLocaleString('en-GB') : 'Unavailable' %></dd>
      <dt>Environment</dt><dd><%= server.platformRelease?.environment || 'Unknown' %></dd>
    </dl>
    <p class="form-hint mt-4">Release metadata is written by install, upgrade, and rollback workflows. The web process does not need Docker access.</p>
  </div>
</section>

<section class="card mb-6"
         aria-labelledby="platform-deployment-title"
         data-platform-release-status-url="/admin/server/releases/status"
         data-platform-release-active="<%= releases.active ? 'true' : 'false' %>"
         data-platform-release-signature="<%= JSON.stringify(releases.history.map(item => [item._id.toString(), item.status])) %>">
  <div class="card__header">
    <h2 class="card__title" id="platform-deployment-title">Platform deployment</h2>
    <% if (releases.active) { %>
    <span class="badge badge--warning"><%= releases.active.status %></span>
    <% } else if (releases.candidate?.eligible && !releases.candidate.sameAsRunning) { %>
    <span class="badge badge--success">Ready</span>
    <% } else { %>
    <span class="badge badge--neutral">Unavailable</span>
    <% } %>
  </div>
  <div class="card__body">
    <div aria-live="polite" class="sr-only" data-platform-release-live></div>
    <% if (releases.candidate?.available) { %>
    <dl class="detail-list mb-4">
      <dt>Latest main SHA</dt><dd><code class="code-inline"><%= releases.candidate.sha %></code></dd>
      <% releases.candidate.checks.forEach(check => { %>
      <dt><%= check.name %></dt><dd><%= check.status === 'completed' ? check.conclusion : check.status %></dd>
      <% }) %>
    </dl>
    <% } else { %>
    <p class="text-muted text-sm mb-4"><%= releases.candidate?.reason || 'Release candidate unavailable.' %></p>
    <% } %>

    <% if (user?.platformRole === 'SUPER_ADMIN' && releases.candidate?.eligible && !releases.candidate.sameAsRunning && !releases.active) { %>
    <form method="POST" action="/admin/server/releases"
          data-confirm="Deploy exact commit <%= releases.candidate.sha %> to hellodeploy.online? The dashboard may briefly restart."
          data-confirm-title="Deploy platform release"
          data-confirm-accept-label="Deploy Release"
          data-confirm-pending-label="Requesting..."
          data-confirm-variant="warning">
      <%- include('../../partials/csrf-field') %>
      <input type="hidden" name="candidateSha" value="<%= releases.candidate.sha %>">
      <button type="submit" class="button button--warning">Deploy latest release</button>
    </form>
    <% } else if (user?.platformRole !== 'SUPER_ADMIN') { %>
    <p class="text-muted text-sm">Only a Super Admin can deploy the platform.</p>
    <% } else if (releases.candidate?.sameAsRunning) { %>
    <p class="text-muted text-sm">The latest eligible release is already running.</p>
    <% } %>

    <% if (releases.history.length > 0) { %>
    <h3 class="mt-6 mb-2">Recent requests</h3>
    <div class="table-wrap">
      <table class="data-table">
        <thead><tr><th scope="col">Release</th><th scope="col">Status</th><th scope="col">Requested</th><th scope="col">Workflow</th></tr></thead>
        <tbody>
          <% releases.history.forEach(item => { %>
          <tr>
            <td><code class="code-inline"><%= item.candidateSha.slice(0, 7) %></code></td>
            <td><%= item.status.replaceAll('_', ' ') %><% if (item.failureCode) { %> · <%= item.failureCode.replaceAll('_', ' ') %><% } %></td>
            <td><%= new Date(item.createdAt).toLocaleString('en-GB') %></td>
            <td><% if (item.workflowRunUrl) { %><a href="<%= item.workflowRunUrl %>" target="_blank" rel="noopener noreferrer">View run</a><% } else { %>Pending<% } %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</section>

<!-- Maintenance mode -->
<div class="card mb-6">
  <div class="card__header">
    <h2 class="card__title">Maintenance Mode</h2>
    <span class="badge <%= maintenance?.enabled ? 'badge--warning' : 'badge--success' %>">
      <%= maintenance?.enabled ? 'Enabled' : 'Disabled' %>
    </span>
  </div>
  <div class="card__body">
    <% if (maintenance?.enabled) { %>
    <p class="text-sm mb-4">
      Mutating user actions are paused. Super Admin actions and safe read-only requests remain available.
    </p>
    <% if (maintenance.message) { %>
    <p class="text-muted text-sm mb-4"><%= maintenance.message %></p>
    <% } %>
    <form method="POST" action="/admin/server/maintenance/disable"
          data-confirm="Disable maintenance mode and allow user mutations again?"
          data-confirm-title="Disable maintenance"
          data-confirm-accept-label="Disable Maintenance"
          data-confirm-pending-label="Disabling..."
          data-confirm-variant="success">
      <%- include('../../partials/csrf-field') %>
      <button type="submit" class="button button--success" data-tooltip="Allow users to create, update, and deploy again.">Disable Maintenance</button>
    </form>
    <% } else { %>
    <form method="POST" action="/admin/server/maintenance/enable"
          data-confirm="Enable maintenance mode? User mutations will be paused."
          data-confirm-title="Enable maintenance"
          data-confirm-accept-label="Enable Maintenance"
          data-confirm-pending-label="Enabling..."
          data-confirm-variant="warning">
      <%- include('../../partials/csrf-field') %>
      <div class="form-group form-group--floating mb-4">
        <label class="form-label" for="maintenance-message">User-facing message</label>
        <input id="maintenance-message" name="message" class="form-input"
               maxlength="300"
               placeholder=" "
               value="HelloDeploy is temporarily in maintenance mode. Please try again later.">
      </div>
      <button type="submit" class="button button--warning" data-tooltip="Pause user write actions while keeping safe read-only access available.">Enable Maintenance</button>
    </form>
    <% } %>
  </div>
</div>

<!-- System stats -->
<div class="stats-grid mb-6">
  <% if (server.cpu) { %>
  <div class="stat-card">
    <span class="stat-card__value"><%= server.cpu.load1 %></span>
    <span class="stat-card__label">Load avg (1m)</span>
    <span class="stat-card__sub"><%= server.cpu.cores %> CPU cores</span>
  </div>
  <% } %>

  <% if (server.memory) { %>
  <div class="stat-card<%= server.memory.usedPercent > 85 ? ' stat-card--alert' : '' %>">
    <span class="stat-card__value"><%= server.memory.usedPercent %>%</span>
    <span class="stat-card__label">Memory Used</span>
    <span class="stat-card__sub"><%= server.memory.usedMb %> / <%= server.memory.totalMb %> MB</span>
  </div>
  <% } %>

  <% if (server.disk) { %>
  <div class="stat-card<%= server.disk.usedPercent > 85 ? ' stat-card--alert' : '' %>">
    <span class="stat-card__value"><%= server.disk.usedPercent %>%</span>
    <span class="stat-card__label">Disk Used</span>
    <span class="stat-card__sub"><%= server.disk.usedGb %> / <%= server.disk.totalGb %> GB</span>
  </div>
  <% } %>

  <div class="stat-card">
    <span class="stat-card__value"><%= server.running ?? '—' %></span>
    <span class="stat-card__label">Running Containers</span>
  </div>
</div>

<!-- MongoDB connectivity -->
<div class="card mb-6">
  <div class="card__header">
    <h2 class="card__title">MongoDB</h2>
    <span class="badge <%= server.mongo?.connected ? 'badge--success' : 'badge--danger' %>">
      <%= server.mongo?.connected ? 'Connected' : 'Unavailable' %>
    </span>
  </div>
  <div class="card__body">
    <% if (server.mongo?.connected) { %>
    <p class="text-sm">Database connection is healthy.</p>
    <% } else { %>
    <p class="text-muted text-sm">Could not reach MongoDB. Most platform features will be unavailable.</p>
    <% } %>
  </div>
</div>

<!-- Worker readiness -->
<div class="card mb-6">
  <div class="card__header">
    <h2 class="card__title">Deployment Worker</h2>
    <span class="badge <%= server.worker?.ready ? 'badge--success' : 'badge--danger' %>">
      <%= server.worker?.ready ? 'Ready' : 'Unavailable' %>
    </span>
  </div>
  <div class="card__body">
    <% if (server.worker?.ready) { %>
    <p class="text-sm">
      <%= server.worker.connectedWorkers %> worker<%= server.worker.connectedWorkers === 1 ? '' : 's' %>
      connected to the deployment queue.
    </p>
    <% } else if (server.worker?.connectedWorkers === null) { %>
    <p class="text-muted text-sm">Worker readiness could not be checked. Verify Redis and queue availability.</p>
    <% } else { %>
    <p class="text-muted text-sm">No deployment worker is connected. Queued jobs will not be processed.</p>
    <% } %>
  </div>
</div>

<!-- Queue management -->
<div class="card mb-6">
  <div class="card__header">
    <h2 class="card__title">Deployment Queue</h2>
    <% if (server.queue) { %>
    <span class="badge <%= server.queue.paused ? 'badge--warning' : 'badge--success' %>">
      <%= server.queue.paused ? 'Paused' : 'Active' %>
    </span>
    <% } %>
  </div>
  <div class="card__body">
    <% if (server.queue) { %>
    <div class="stats-grid stats-grid--sm mb-4">
      <div class="stat-card stat-card--sm">
        <span class="stat-card__value"><%= server.queue.waiting ?? 0 %></span>
        <span class="stat-card__label">Waiting</span>
      </div>
      <div class="stat-card stat-card--sm">
        <span class="stat-card__value"><%= server.queue.active ?? 0 %></span>
        <span class="stat-card__label">Active</span>
      </div>
      <div class="stat-card stat-card--sm">
        <span class="stat-card__value"><%= server.queue.delayed ?? 0 %></span>
        <span class="stat-card__label">Delayed</span>
      </div>
      <div class="stat-card stat-card--sm">
        <span class="stat-card__value"><%= server.queue.failed ?? 0 %></span>
        <span class="stat-card__label">Failed</span>
      </div>
    </div>
    <% } else { %>
    <p class="text-muted text-sm">Queue is not available (Redis may be disconnected).</p>
    <% } %>

    <div class="button-group">
      <% if (server.queue?.paused) { %>
      <form method="POST" action="/admin/server/queue/resume"
            data-confirm="Resume the deployment queue? Queued jobs will start running again."
            data-confirm-title="Resume deployment queue"
            data-confirm-accept-label="Resume Queue"
            data-confirm-pending-label="Resuming..."
            data-confirm-variant="success">
        <%- include('../../partials/csrf-field') %>
        <button type="submit" class="button button--success" data-tooltip="Allow queued deployment jobs to start again.">Resume Queue</button>
      </form>
      <% } else { %>
      <form method="POST" action="/admin/server/queue/pause"
            data-confirm="Pause the deployment queue? Running jobs will finish, but no new jobs will start."
            data-confirm-title="Pause deployment queue"
            data-confirm-accept-label="Pause Queue"
            data-confirm-pending-label="Pausing..."
            data-confirm-variant="warning">
        <%- include('../../partials/csrf-field') %>
        <button type="submit" class="button button--warning" data-tooltip="Stop new deployment jobs from starting; running jobs can finish.">Pause Queue</button>
      </form>
      <% } %>
    </div>
  </div>
</div>

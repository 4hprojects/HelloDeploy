<div class="page-header">
  <div>
    <h1 class="page-header__title">Quota Override — <%= scopeName %></h1>
    <p class="page-header__subtitle text-muted text-sm">
      <%= scopeType %> / <code class="code-inline"><%= scopeId %></code>
    </p>
  </div>
</div>

<% const isProject = scopeType === 'PROJECT'; %>
<% const hasValue = (doc, key) => doc?.[key] !== null && doc?.[key] !== undefined; %>
<% const show = (doc, key) => hasValue(doc, key) ? doc[key] : '—'; %>
<% const hasErrors = typeof errors !== 'undefined'; %>
<% const values = typeof formValues !== 'undefined' ? formValues : null; %>

<div class="card">
  <div class="card__header">
    <span class="card__title">Effective Limits</span>
  </div>
  <div class="card__body">
    <p class="text-sm text-muted mb-4">
      <% if (isProject) { %>
      Resolution order: this project's override → owner's override → plan default.
      <% } else { %>
      Resolution order: this user's override → plan default. Per-project limits set here apply to all projects this user owns, unless a project has its own override.
      <% } %>
    </p>
    <div class="table-wrapper table-responsive">
      <table class="table table--responsive">
        <thead>
          <tr>
            <th scope="col">Limit</th>
            <th scope="col">Plan default</th>
            <% if (isProject) { %><th scope="col">Owner override</th><% } %>
            <th scope="col">This override</th>
            <th scope="col">Effective</th>
            <th scope="col">Usage</th>
          </tr>
        </thead>
        <tbody>
          <% fields.forEach(({ key, label }) => { %>
          <% const isOverLimit = usage[key] !== undefined && usage[key] > effective[key]; %>
          <tr>
            <td data-label="Limit"><%= label %></td>
            <td data-label="Plan default"><%= defaults[key] %></td>
            <% if (isProject) { %><td data-label="Owner override"><%= show(inherited, key) %></td><% } %>
            <td data-label="This override"><%= show(override, key) %></td>
            <td data-label="Effective"><strong><%= effective[key] %></strong></td>
            <td data-label="Usage">
              <% if (usage[key] === undefined) { %>
              <span class="text-muted">—</span>
              <% } else { %>
              <%= usage[key] %> of <%= effective[key] %>
              <% if (isOverLimit) { %><span class="status-badge status-badge--failed">Over limit</span><% } %>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% if (override?.reason) { %>
    <p class="text-sm text-muted mt-4">Last reason: <%= override.reason %></p>
    <% } %>
  </div>
</div>

<div class="card mt-6">
  <div class="card__header">
    <span class="card__title">Set Quota Override</span>
  </div>
  <div class="card__body">
    <p class="text-sm text-muted mb-4">Leave a field empty to remove its override and inherit the value shown in the placeholder. Clear every field to remove the override entirely.</p>
    <form method="POST" action="/admin/quotas/<%= scopeType %>/<%= scopeId %>">
      <%- include('../../partials/csrf-field') %>

      <div class="form-grid form-grid--2">
        <% fields.forEach(({ key, label, hint, isInteger, min = 0 }) => { %>
        <% const fieldError = hasErrors ? errors[key] : null; %>
        <% const inheritedValue = isProject && hasValue(inherited, key) ? inherited[key] : defaults[key]; %>
        <div class="form-group form-group--floating">
          <label class="form-label" for="<%= key %>"><%= label %></label>
          <input type="number" id="<%= key %>" name="<%= key %>"
                 class="form-input<%= fieldError ? ' form-input--error' : '' %>"
                 data-tooltip="<%= hint %>"
                 min="<%= min %>" step="<%= isInteger ? '1' : '0.05' %>"
                 value="<%= values ? (values[key] ?? '') : (hasValue(override, key) ? override[key] : '') %>"
                 placeholder="Inherit (<%= inheritedValue %>)"
                 <% if (fieldError) { %>aria-invalid="true" aria-describedby="<%= key %>-error"<% } %> />
          <% if (fieldError) { %>
          <p class="form-error" id="<%= key %>-error" role="alert"><%= fieldError %></p>
          <% } %>
        </div>
        <% }) %>
      </div>

      <% const reasonError = hasErrors ? errors.reason : null; %>
      <div class="form-group form-group--floating mt-4">
        <label class="form-label" for="reason">Reason for change</label>
        <input type="text" id="reason" name="reason" required maxlength="500"
               class="form-input<%= reasonError ? ' form-input--error' : '' %>"
               value="<%= values?.reason ?? '' %>" placeholder="Recorded in the audit log"
               <% if (reasonError) { %>aria-invalid="true" aria-describedby="reason-error"<% } %> />
        <% if (reasonError) { %>
        <p class="form-error" id="reason-error" role="alert"><%= reasonError %></p>
        <% } %>
      </div>

      <div class="button-group mt-6">
        <button type="submit" class="button button--primary" data-pending-label="Saving...">Save Quota Override</button>
        <a href="<%= isProject ? '/admin/projects' : `/admin/users/${scopeId}` %>" class="button button--ghost">Cancel</a>
      </div>
    </form>
  </div>
</div>

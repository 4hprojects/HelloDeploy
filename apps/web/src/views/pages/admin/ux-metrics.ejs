<%
const activationMetrics = [
  ['Accounts created', 'signup_completed'],
  ['Projects created', 'project_created'],
  ['First deploys live', 'first_deploy_succeeded'],
  ['First deploy failures', 'first_deploy_failed'],
];
const hasEvents = Object.values(metrics.counts).some((count) => count > 0);
const hasVitals = Object.keys(metrics.p75).length > 0;
%>
<div class="page-header page-header--actions">
  <div>
    <h1 class="page-header__title">UX Metrics</h1>
    <p class="page-header__subtitle">Privacy-minimized activation, recovery, and field-performance signals.</p>
  </div>
  <nav class="button-group" aria-label="Metric period">
    <% [7, 30, 90].forEach(days => { %>
    <a class="button button--<%= metrics.days === days ? 'primary' : 'secondary' %> button--sm" href="/admin/ux-metrics?days=<%= days %>" <%- metrics.days === days ? 'aria-current="page"' : '' %>><%= days %> days</a>
    <% }) %>
  </nav>
</div>

<% if (!hasEvents && !hasVitals) { %>
<div class="empty-state mb-6">
  <p class="empty-state__title">No signals in the last <%= metrics.days %> days</p>
  <p class="empty-state__description">Counts and Web Vitals appear once people sign up, create projects, and load pages. Try a longer period.</p>
</div>
<% } %>

<section class="card mb-6" aria-labelledby="activation-title">
  <div class="card__header"><h2 class="card__title" id="activation-title">Activation and recovery</h2></div>
  <div class="card__body">
    <div class="stats-grid stats-grid--sm">
      <% activationMetrics.forEach(([label, key]) => { %>
      <div class="stat-card stat-card--sm">
        <span class="stat-card__value"><%= metrics.counts[key] || 0 %></span>
        <span class="stat-card__label"><%= label %></span>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="card" aria-labelledby="vitals-title">
  <div class="card__header"><h2 class="card__title" id="vitals-title">Web Vitals p75</h2></div>
  <div class="card__body">
    <div class="table-wrapper table-responsive table-responsive--flush">
      <table class="table table--responsive">
        <thead>
          <tr>
            <th scope="col">Metric</th>
            <th scope="col">Mobile</th>
            <th scope="col">Desktop</th>
          </tr>
        </thead>
        <tbody>
          <% ['LCP', 'INP', 'CLS'].forEach(metric => { %>
          <tr>
            <th scope="row" data-label="Metric"><%= metric %></th>
            <td data-label="Mobile"><%= metrics.p75[`${metric}:mobile`] ?? 'No data' %></td>
            <td data-label="Desktop"><%= metrics.p75[`${metric}:desktop`] ?? 'No data' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <p class="form-hint mt-4">P75 values are calculated from bounded, first-party measurements. No IP address, repository name, URL, credential, or secret value is stored.</p>
  </div>
</section>

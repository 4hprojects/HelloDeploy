<div class="page-header">
  <h1 class="page-header__title">All Projects</h1>
  <p class="page-header__subtitle"><%= total %> total</p>
</div>

<form method="GET" action="/admin/projects" class="filter-bar list-filters list-filters--one-select mb-6" role="search" aria-label="Filter projects">
  <div class="list-filters__grid">
    <div class="form-group list-filters__search">
      <label class="form-label" for="admin-project-search">Search</label>
      <div class="search-field">
        <input class="form-input search-field__input" type="search" id="admin-project-search" name="search" value="<%= filters.search %>" placeholder="Search by name or slug…" autocomplete="off">
        <button class="button button--secondary search-field__button" type="submit">Search</button>
      </div>
    </div>
    <div class="form-group">
      <label class="form-label" for="admin-project-status">Status</label>
      <select class="form-select" id="admin-project-status" name="status" data-auto-submit>
        <option value="">All statuses</option>
        <option value="DRAFT" <%= filters.status === 'DRAFT' ? 'selected' : '' %>>Draft</option>
        <option value="ACTIVE" <%= filters.status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
        <option value="SUSPENDED" <%= filters.status === 'SUSPENDED' ? 'selected' : '' %>>Suspended</option>
        <option value="ARCHIVED" <%= filters.status === 'ARCHIVED' ? 'selected' : '' %>>Archived</option>
      </select>
    </div>
    <% if (filters.search || filters.status) { %>
    <a href="/admin/projects" class="button button--ghost list-filters__clear">Clear</a>
    <% } %>
  </div>
</form>

<% if (projects.length === 0) { %>
<div class="empty-state">
  <p class="empty-state__title">No projects match your filters</p>
  <p class="empty-state__description">Adjust the search or status filter to broaden the result set.</p>
  <div class="empty-state__actions">
    <a href="/admin/projects" class="button button--ghost">Clear Filters</a>
  </div>
</div>
<% } else { %>
<div class="table-wrapper table-responsive">
  <table class="table table--responsive">
    <thead>
      <tr>
        <th scope="col">Project</th>
        <th scope="col">Owner</th>
        <th scope="col">Status</th>
        <th scope="col">Created</th>
        <th scope="col"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% projects.forEach(p => { %>
      <tr>
        <td data-label="Project">
          <a href="/projects/<%= p.slug %>" class="table-link"><strong><%= p.name %></strong></a>
          <span class="text-muted text-xs d-block"><%= p.slug %></span>
        </td>
        <td data-label="Owner">
          <% if (p.ownerId) { %>
          <span><%= p.ownerId.firstName %> <%= p.ownerId.lastName %></span>
          <span class="text-muted text-xs d-block"><%= p.ownerId.email %></span>
          <% } else { %>
          <span class="text-muted">—</span>
          <% } %>
        </td>
        <td data-label="Status">
          <%- include('../../partials/status-badge', { status: p.status }) %>
          <% if (p.status === 'SUSPENDED' && p.suspensionReason) { %>
          <span class="text-muted text-xs d-block">Reason: <%= p.suspensionReason %></span>
          <% } %>
        </td>
        <td class="text-sm text-muted" data-label="Created"><%= new Date(p.createdAt).toLocaleDateString('en-GB') %></td>
        <td class="text-right" data-label="Actions">
          <a href="/admin/quotas/PROJECT/<%= p._id %>" class="button button--ghost button--sm">Manage Quota</a>
          <% if (p.status === 'SUSPENDED') { %>
          <form method="POST" action="/admin/projects/<%= p._id %>/reactivate" class="d-inline"
                data-confirm="Reactivate project <%= p.name %> and restore user access to it?"
                data-confirm-title="Reactivate project"
                data-confirm-accept-label="Reactivate Project"
                data-confirm-pending-label="Reactivating..."
                data-confirm-variant="success">
            <%- include('../../partials/csrf-field') %>
            <button type="submit" class="button button--ghost button--sm">Reactivate</button>
          </form>
          <% } else if (p.status === 'ACTIVE' || p.status === 'DRAFT') { %>
          <form method="POST" action="/admin/projects/<%= p._id %>/suspend" class="d-inline"
                data-confirm="Suspend project <%= p.name %> and pause user access to it?"
                data-confirm-title="Suspend project"
                data-confirm-accept-label="Suspend Project"
                data-confirm-pending-label="Suspending..."
                data-confirm-variant="warning"
                data-confirm-reason>
            <%- include('../../partials/csrf-field') %>
            <input type="hidden" name="reason" value="" />
            <button type="submit" class="button button--ghost button--sm">Suspend</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (totalPages > 1) { %>
<div class="pagination mt-4">
  <% if (page > 1) { %>
  <a href="?page=<%= page - 1 %>&status=<%= encodeURIComponent(filters.status) %>&search=<%= encodeURIComponent(filters.search) %>" class="button button--ghost button--sm">Previous</a>
  <% } %>
  <span class="pagination__info text-sm text-muted">Page <%= page %> of <%= totalPages %></span>
  <% if (page < totalPages) { %>
  <a href="?page=<%= page + 1 %>&status=<%= encodeURIComponent(filters.status) %>&search=<%= encodeURIComponent(filters.search) %>" class="button button--ghost button--sm">Next</a>
  <% } %>
</div>
<% } %>
<% } %>

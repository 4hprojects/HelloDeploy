<%
// Routing state comes from the last end-to-end reachability probe.
const ROUTING_STATES = {
  LIVE: { tone: 'healthy', label: 'Reachable' },
  FOREIGN: { tone: 'failed', label: 'Points elsewhere' },
  TUNNEL_DOWN: { tone: 'failed', label: 'Tunnel down' },
  NOT_POINTED: { tone: 'pending', label: 'DNS not pointed' },
  UNKNOWN: { tone: 'draft', label: 'Not checked yet' },
};
const routingBadge = (state) => {
  const r = ROUTING_STATES[state] || ROUTING_STATES.UNKNOWN;
  return `<span class="status-badge status-badge--${r.tone}">${r.label}</span>`;
};
%>
<div class="page-header">
  <h1 class="page-header__title">Domain Approval Queue</h1>
  <% if (domains.length) { %>
  <p class="page-header__subtitle"><%= domains.length %> awaiting approval</p>
  <% } %>
</div>

<% if (domains.length === 0) { %>
<div class="card">
  <div class="card__body">
    <div class="empty-state">
      <p class="empty-state__title">No domains awaiting approval</p>
      <p class="empty-state__description">Verified custom domains will appear here for review before routing is activated.</p>
      <ul class="empty-state__steps">
        <li>Project owners add a custom domain from the project domain page.</li>
        <li>HelloDeploy waits for DNS TXT verification.</li>
        <li>Verified domains appear here for approval or rejection.</li>
      </ul>
    </div>
  </div>
</div>
<% } else { %>
<div class="card">
  <div class="card__body">
    <div class="table-wrapper table-responsive table-responsive--flush">
    <table class="table table--responsive">
      <thead>
        <tr>
          <th scope="col">Hostname</th>
          <th scope="col">Project</th>
          <th scope="col">Verified</th>
          <th scope="col"><span class="sr-only">Actions</span></th>
        </tr>
      </thead>
      <tbody>
        <% domains.forEach(d => { %>
        <tr>
          <td data-label="Hostname"><code class="code-inline"><%= d.hostnameNormalized %></code></td>
          <td data-label="Project">
            <% if (d.projectId && d.projectId.name) { %>
              <a href="/projects/<%= d.projectId.slug %>" class="table-link"><%= d.projectId.name %></a>
            <% } else { %>
              <span class="text-muted">Unknown</span>
            <% } %>
          </td>
          <td class="text-muted text-sm" data-label="Verified">
            <% if (d.verifiedAt) { %>
              <%= new Date(d.verifiedAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
            <% } else { %> — <% } %>
            <% const liveTxt = liveTxtRecordsById.get(d._id.toString()); %>
            <% if (liveTxt) { %>
              <span class="text-xs d-block">Live TXT: <code class="code-inline"><%= liveTxt.join(', ') %></code></span>
            <% } else { %>
              <span class="text-xs d-block">Live TXT: no record found now</span>
            <% } %>
          </td>
          <td class="text-right" data-label="Actions">
            <div class="button-group button-group--sm">
              <form method="POST" action="/admin/domains/<%= d._id %>/approve"
                    data-confirm="Approve <%= d.hostnameNormalized %> and queue route activation?"
                    data-confirm-title="Approve domain"
                    data-confirm-accept-label="Approve Domain"
                    data-confirm-pending-label="Approving..."
                    data-confirm-variant="success">
                <%- include('../../partials/csrf-field') %>
                <button type="submit" class="button button--success button--sm" data-tooltip="Approve this verified domain and queue route activation.">Approve</button>
              </form>
              <form method="POST" action="/admin/domains/<%= d._id %>/reject"
                    data-confirm="Reject <%= d.hostnameNormalized %> and keep routing inactive?"
                    data-confirm-title="Reject domain"
                    data-confirm-accept-label="Reject Domain"
                    data-confirm-pending-label="Rejecting..."
                    data-confirm-variant="danger"
                    data-confirm-reason>
                <%- include('../../partials/csrf-field') %>
                <input type="hidden" name="reason" value="">
                <button type="submit" class="button button--danger button--sm" data-tooltip="Reject this domain request and keep routing inactive.">Reject</button>
              </form>
            </div>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
  </div>
</div>
<% } %>

<% if (locals.customHostnameUsage) { %>
<% const _usage = customHostnameUsage; %>
<% const _nearLimit = _usage.used !== null && _usage.used >= _usage.limit * 0.9; %>
<div class="card mt-4<%= _nearLimit ? ' card--warning' : '' %>">
  <div class="card__body">
    <p class="text-sm"><strong>Cloudflare custom hostnames:</strong>
      <% if (_usage.used === null) { %>
        usage unavailable (Cloudflare could not be reached)
      <% } else { %>
        <%= _usage.used %> of <%= _usage.limit %> used
      <% } %>
    </p>
    <% if (_nearLimit) { %>
    <p class="text-sm mt-2">Close to the free allowance. At <%= _usage.limit %>, owners can't connect
      new domains. Remove stale hostnames in the Cloudflare dashboard, or raise the limit in code only
      after deciding to pay.</p>
    <% } %>
  </div>
</div>
<% } %>

<div class="card mt-4">
  <div class="card__header">
    <div>
      <h2 class="card__title">Custom domain tunnels</h2>
      <p class="card__subtitle">Each custom domain reaches this platform through its own Cloudflare
        tunnel. Create the tunnel with the domain owner's Cloudflare account, then record its id
        here so the owner can publish the matching CNAME.</p>
    </div>
  </div>
  <div class="card__body">
    <% if (!routableDomains.length) { %>
    <div class="empty-state">
      <p class="empty-state__title">No verified domains yet</p>
      <p class="empty-state__description">Domains appear here once their ownership TXT record is verified, so their tunnel can be recorded.</p>
    </div>
    <% } else { %>
    <div class="table-wrapper table-responsive table-responsive--flush">
    <table class="table table--responsive">
      <thead>
        <tr>
          <th scope="col">Hostname</th>
          <th scope="col">Project</th>
          <th scope="col">Tunnel</th>
          <th scope="col"><span class="sr-only">Record tunnel</span></th>
        </tr>
      </thead>
      <tbody>
        <% routableDomains.forEach(d => { %>
        <tr>
          <td data-label="Hostname"><code class="code-inline"><%= d.hostnameNormalized %></code></td>
          <td data-label="Project">
            <% if (d.projectId && d.projectId.name) { %>
              <a href="/projects/<%= d.projectId.slug %>" class="table-link"><%= d.projectId.name %></a>
            <% } else { %>
              <span class="text-muted">Unknown</span>
            <% } %>
          </td>
          <td data-label="Tunnel">
            <% if (d.cfCustomHostnameId) { %>
              <span>Connected automatically (Cloudflare custom hostname)</span>
              <span class="text-xs d-block text-muted">Cloudflare: <%= d.cfHostnameStatus || 'unknown' %>, certificate <%= d.cfSslStatus || 'unknown' %>.</span>
              <span class="d-block mt-1"><%- routingBadge(d.routingState) %></span>
            <% } else if (d.tunnelId) { %>
              <code class="code-inline"><%= d.tunnelId %>.cfargotunnel.com</code>
              <span class="d-block mt-1"><%- routingBadge(d.routingState) %></span>
            <% } else { %>
              <span class="text-muted">Not recorded</span>
              <span class="text-xs d-block">Run: <code class="code-inline">sudo bash infrastructure/provision-custom-domain-tunnel.sh --hostname <%= d.hostnameNormalized %> --tunnel-id &lt;uuid&gt;</code></span>
            <% } %>
          </td>
          <td class="text-right" data-label="Record tunnel">
            <% if (!d.cfCustomHostnameId) { %>
            <form method="POST" action="/admin/domains/<%= d._id %>/tunnel" class="form-inline"
                  data-confirm="Record this tunnel for <%= d.hostnameNormalized %>? The owner is shown the matching CNAME target."
                  data-confirm-title="Record tunnel"
                  data-confirm-accept-label="Save Tunnel"
                  data-confirm-pending-label="Saving..."
                  data-confirm-variant="warning">
              <%- include('../../partials/csrf-field') %>
              <label class="sr-only" for="tunnel-<%= d._id %>">Tunnel id for <%= d.hostnameNormalized %></label>
              <input type="text" id="tunnel-<%= d._id %>" name="tunnelId" class="form-input form-input--sm"
                value="<%= d.tunnelId || '' %>" placeholder="00000000-0000-0000-0000-000000000000"
                pattern="[0-9a-fA-F-]{36}" required>
              <button type="submit" class="button button--secondary button--sm"
                data-pending-label="Saving...">Save</button>
            </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    </div>
    <% } %>
  </div>
</div>

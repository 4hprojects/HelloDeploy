<div class="page-header">
  <h1 class="page-header__title">Approval Requests</h1>
  <p class="page-header__subtitle"><%= total %> pending</p>
</div>

<% if (requests.length === 0) { %>
<div class="empty-state">
  <div class="empty-state__icon"><%- include('../../partials/icon', { name: 'reviews' }) %></div>
  <h2 class="empty-state__title">No pending requests</h2>
  <p class="empty-state__description">There are no project reviews waiting for your decision.</p>
  <ul class="empty-state__steps">
    <li>New project review submissions appear here automatically.</li>
    <li>Review the saved application purpose, source, and readiness findings.</li>
    <li>Use the audit log to review recent admin decisions.</li>
  </ul>
  <div class="empty-state__actions">
    <a href="/admin/projects" class="button button--secondary">View Projects</a>
    <a href="/admin/audit-events" class="button button--ghost">Audit Log</a>
  </div>
</div>
<% } else { %>
<div class="review-list">
  <% requests.forEach(r => {
    const project = r.projectId;
    const repository = project?.repositoryId;
    const owner = project?.ownerId;
    const submittedMs = Date.now() - new Date(r.createdAt).getTime();
    const submittedHours = Math.max(0, Math.floor(submittedMs / 3600000));
    const submittedAge = submittedHours < 1 ? 'Less than an hour ago' : submittedHours < 24 ? `${submittedHours} hour${submittedHours === 1 ? '' : 's'} ago` : `${Math.floor(submittedHours / 24)} day${Math.floor(submittedHours / 24) === 1 ? '' : 's'} ago`;
    const config = project?.buildConfiguration || {};
  %>
  <article class="card mb-4 approval-review">
    <div class="card__header">
      <div>
        <strong><%= project ? project.name : 'Missing project' %></strong>
        <% if (project) { %><span class="text-muted text-sm"> · <%= project.slug %></span><% } %>
      </div>
      <span class="text-sm text-muted"><%= submittedAge %></span>
    </div>
    <div class="card__body">
      <% if (!r.snapshotState.hasSnapshot) { %>
      <div class="alert alert--warning mb-4" role="alert">
        This is a legacy request without a saved review snapshot. It cannot be approved; request changes so the owner can resubmit.
      </div>
      <% } else if (!r.snapshotState.isCurrent) { %>
      <div class="alert alert--warning mb-4" role="alert">
        The repository, application check, or project settings changed after submission. Approval is blocked until the owner checks and resubmits.
      </div>
      <% } %>

      <div class="approval-review__grid">
        <section aria-labelledby="purpose-<%= r._id %>">
          <h2 class="text-sm" id="purpose-<%= r._id %>">Application purpose</h2>
          <p class="mt-1"><%= r.purpose || 'Not provided in this legacy request.' %></p>
        </section>
        <dl class="detail-list">
          <dt>Owner</dt>
          <dd><%= owner ? `${owner.firstName} ${owner.lastName} (${owner.email})` : 'Unavailable' %></dd>
          <dt>Submitted by</dt>
          <dd><%= r.requestedBy ? `${r.requestedBy.firstName} ${r.requestedBy.lastName} (${r.requestedBy.email})` : 'Unavailable' %></dd>
          <dt>Source repository</dt>
          <dd><%= repository?.fullName || 'Not connected' %></dd>
          <dt>Production branch</dt>
          <dd><%= project?.productionBranch || 'Not selected' %></dd>
          <dt>Checked commit</dt>
          <dd><code class="code-inline"><%= r.snapshotCommitSha ? r.snapshotCommitSha.slice(0, 7) : 'Not saved' %></code></dd>
          <dt>Application type</dt>
          <dd><%= project?.runtimeType || 'Not detected' %></dd>
          <dt>Deployment mode</dt>
          <dd><%= project?.deploymentMode?.replaceAll('_', ' ') || 'Unavailable' %></dd>
          <dt>Configuration version</dt>
          <dd><%= r.snapshotConfigurationVersion || 'Not saved' %></dd>
        </dl>
        <section aria-labelledby="config-<%= r._id %>">
          <h2 class="text-sm" id="config-<%= r._id %>">Configuration summary</h2>
          <dl class="detail-list mt-2">
            <dt>Build command</dt><dd><code class="code-inline"><%= config.buildCommand || 'None' %></code></dd>
            <dt>Start command</dt><dd><code class="code-inline"><%= config.startCommand || 'None' %></code></dd>
            <dt>Output folder</dt><dd><code class="code-inline"><%= config.outputDirectory || 'None' %></code></dd>
            <dt>Application port</dt><dd><%= config.applicationPort || 'Not used' %></dd>
            <dt>Health check</dt><dd><code class="code-inline"><%= config.healthCheckPath || '/' %></code></dd>
          </dl>
        </section>
        <section aria-labelledby="findings-<%= r._id %>">
          <h2 class="text-sm" id="findings-<%= r._id %>">Readiness at submission</h2>
          <% const findings = r.validationFindings?.length ? r.validationFindings : r.currentFindings; %>
          <% if (findings?.length) { %>
          <ul class="approval-findings mt-2">
            <% findings.forEach(item => { %>
            <li class="approval-finding approval-finding--<%= item.status.toLowerCase() %>">
              <strong><%= item.label %></strong><span><%= item.message %></span>
            </li>
            <% }) %>
          </ul>
          <% } else { %>
          <p class="text-sm text-muted mt-2">No findings were saved.</p>
          <% } %>
        </section>
      </div>

      <form method="POST" action="/admin/approval-requests/<%= r._id %>/review" class="review-form mt-4">
        <%- include('../../partials/csrf-field') %>
        <div class="form-group mb-3">
          <label for="note-<%= r._id %>" class="form-label">Review note</label>
          <textarea id="note-<%= r._id %>" name="note" class="form-textarea" rows="3"
            maxlength="1000" required aria-describedby="note-hint-<%= r._id %>"></textarea>
          <p class="form-hint" id="note-hint-<%= r._id %>">Required when requesting changes; optional when approving.</p>
        </div>
        <div class="button-group">
          <button type="submit" name="decision" value="APPROVED" class="button button--primary button--sm"
            formnovalidate
            data-confirm="Approve <%= project ? project.name : 'this project' %>? It will go live immediately."
            data-confirm-title="Approve project"
            data-confirm-accept-label="Approve"
            data-confirm-pending-label="Approving..."
            data-confirm-variant="success"
            <%= !r.snapshotState.isCurrent ? 'disabled' : '' %>>Approve</button>
          <button type="submit" name="decision" value="CHANGES_REQUESTED" class="button button--secondary button--sm"
            data-confirm="Request changes on <%= project ? project.name : 'this project' %>? The owner will need to update and resubmit."
            data-confirm-title="Request changes"
            data-confirm-accept-label="Request Changes"
            data-confirm-pending-label="Sending..."
            data-confirm-variant="warning">Request changes</button>
        </div>
      </form>
    </div>
  </article>
  <% }) %>
</div>

<% if (totalPages > 1) { %>
<nav class="pagination mt-4" aria-label="Approval request pages">
  <% if (page > 1) { %><a href="?page=<%= page - 1 %>" class="button button--ghost button--sm">Previous</a><% } %>
  <span class="pagination__info text-sm text-muted">Page <%= page %> of <%= totalPages %></span>
  <% if (page < totalPages) { %><a href="?page=<%= page + 1 %>" class="button button--ghost button--sm">Next</a><% } %>
</nav>
<% } %>
<% } %>

<%
// Mirrors manageUserError in admin.service.js; the server still enforces it.
const canManage = (u) =>
  u._id.toString() !== user.id &&
  u.platformRole !== 'SUPER_ADMIN' &&
  (u.platformRole !== 'ADMIN' || user.platformRole === 'SUPER_ADMIN');
const ROLE_LABELS = { USER: 'User', ADMIN: 'Admin', SUPER_ADMIN: 'Super admin' };
const filterQuery = `status=${encodeURIComponent(filters.status)}&role=${encodeURIComponent(filters.role)}&search=${encodeURIComponent(filters.search)}`;
%>
<div class="page-header">
  <h1 class="page-header__title">Users</h1>
  <p class="page-header__subtitle"><%= total %> total</p>
</div>

<form method="GET" action="/admin/users" class="filter-bar list-filters mb-6" role="search" aria-label="Filter users">
  <div class="list-filters__grid">
    <div class="form-group list-filters__search">
      <label class="form-label" for="user-search">Search</label>
      <div class="search-field">
        <input class="form-input search-field__input" type="search" id="user-search" name="search" value="<%= filters.search %>" placeholder="Search by name or email…" autocomplete="off">
        <button class="button button--secondary search-field__button" type="submit">Search</button>
      </div>
    </div>
    <div class="form-group">
      <label class="form-label" for="user-status">Status</label>
      <select class="form-select" id="user-status" name="status" data-auto-submit>
        <option value="">All statuses</option>
        <option value="PENDING_VERIFICATION" <%= filters.status === 'PENDING_VERIFICATION' ? 'selected' : '' %>>Pending</option>
        <option value="ACTIVE" <%= filters.status === 'ACTIVE' ? 'selected' : '' %>>Active</option>
        <option value="SUSPENDED" <%= filters.status === 'SUSPENDED' ? 'selected' : '' %>>Suspended</option>
        <option value="ARCHIVED" <%= filters.status === 'ARCHIVED' ? 'selected' : '' %>>Archived</option>
      </select>
    </div>
    <div class="form-group">
      <label class="form-label" for="user-role">Role</label>
      <select class="form-select" id="user-role" name="role" data-auto-submit>
        <option value="">All roles</option>
        <% ['USER', 'ADMIN', 'SUPER_ADMIN'].forEach(r => { %>
        <option value="<%= r %>" <%= filters.role === r ? 'selected' : '' %>><%= ROLE_LABELS[r] %></option>
        <% }) %>
      </select>
    </div>
    <% if (filters.search || filters.status || filters.role) { %>
    <a href="/admin/users" class="button button--ghost list-filters__clear">Clear</a>
    <% } %>
  </div>
</form>

<% if (users.length === 0) { %>
<div class="empty-state">
  <p class="empty-state__title">No users match your filters</p>
  <p class="empty-state__description">Adjust the search or status filter to broaden the result set.</p>
  <div class="empty-state__actions">
    <a href="/admin/users" class="button button--ghost">Clear Filters</a>
  </div>
</div>
<% } else { %>
<div class="table-wrapper table-responsive">
  <table class="table table--responsive">
    <thead>
      <tr>
        <th scope="col">User</th>
        <th scope="col">Role</th>
        <th scope="col">Status</th>
        <th scope="col">Joined</th>
        <th scope="col">Last login</th>
        <th scope="col"><span class="sr-only">Actions</span></th>
      </tr>
    </thead>
    <tbody>
      <% users.forEach(u => { %>
      <tr>
        <td data-label="User">
          <a href="/admin/users/<%= u._id %>" class="table-link"><strong><%= u.firstName %> <%= u.lastName %></strong></a>
          <span class="text-muted text-xs d-block"><%= u.email %></span>
        </td>
        <td data-label="Role"><span class="role-pill"><%= ROLE_LABELS[u.platformRole] || u.platformRole %></span></td>
        <td data-label="Status">
          <%- include('../../partials/status-badge', { status: u.status, statusKind: 'user' }) %>
          <% if (u.lockedUntil && new Date(u.lockedUntil) > now) { %>
          <span class="status-badge status-badge--warning" data-tooltip="Too many failed sign-ins. Unlock from the user page.">Locked</span>
          <% } %>
          <% if (u.closureRequestedAt) { %>
          <span class="status-badge status-badge--warning" data-tooltip="The user asked to close this account. A Super Admin completes it from the user page.">Closure requested</span>
          <% } %>
          <% if (u.status === 'SUSPENDED' && u.suspensionReason) { %>
          <span class="text-muted text-xs d-block">Reason: <%= u.suspensionReason %></span>
          <% } %>
        </td>
        <td class="text-sm text-muted" data-label="Joined"><%= new Date(u.createdAt).toLocaleDateString('en-GB') %></td>
        <td class="text-sm text-muted" data-label="Last login"><%= u.lastLoginAt ? new Date(u.lastLoginAt).toLocaleDateString('en-GB') : 'Never' %></td>
        <td class="text-right" data-label="Actions">
          <a href="/admin/users/<%= u._id %>" class="button button--ghost button--sm">Manage</a>
          <% if (canManage(u) && u.status === 'SUSPENDED') { %>
          <form method="POST" action="/admin/users/<%= u._id %>/reactivate" class="d-inline"
                data-confirm="Reactivate <%= u.firstName %> <%= u.lastName %> and restore account access?"
                data-confirm-title="Reactivate user"
                data-confirm-accept-label="Reactivate User"
                data-confirm-pending-label="Reactivating..."
                data-confirm-variant="success">
            <%- include('../../partials/csrf-field') %>
            <button type="submit" class="button button--ghost button--sm">Reactivate</button>
          </form>
          <% } else if (canManage(u) && ['ACTIVE', 'PENDING_VERIFICATION'].includes(u.status)) { %>
          <form method="POST" action="/admin/users/<%= u._id %>/suspend" class="d-inline"
                data-confirm="Suspend <%= u.firstName %> <%= u.lastName %> and block account access?"
                data-confirm-title="Suspend user"
                data-confirm-accept-label="Suspend User"
                data-confirm-pending-label="Suspending..."
                data-confirm-variant="warning"
                data-confirm-reason>
            <%- include('../../partials/csrf-field') %>
            <input type="hidden" name="reason" value="" />
            <button type="submit" class="button button--ghost button--sm">Suspend</button>
          </form>
          <% } %>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (totalPages > 1) { %>
<div class="pagination mt-4">
  <% if (page > 1) { %>
  <a href="?page=<%= page - 1 %>&<%= filterQuery %>" class="button button--ghost button--sm">Previous</a>
  <% } %>
  <span class="pagination__info text-sm text-muted">Page <%= page %> of <%= totalPages %></span>
  <% if (page < totalPages) { %>
  <a href="?page=<%= page + 1 %>&<%= filterQuery %>" class="button button--ghost button--sm">Next</a>
  <% } %>
</div>
<% } %>
<% } %>

<div class="page-header">
  <h1 class="page-header__title">Admin Overview</h1>
</div>

<%
  const workerDown = server?.worker && !server.worker.ready;
  const queuePaused = server?.queue?.paused;
  const failedJobs = server?.queue?.failed ?? 0;
  const needsAttention = workerDown || queuePaused || failedJobs > 0;
%>
<% if (needsAttention) { %>
<div class="alert alert--warning mb-6" role="alert">
  <strong>Needs attention</strong>
  <ul class="mt-1">
    <% if (workerDown) { %><li>No deployment worker is connected — queued jobs will not be processed.</li><% } %>
    <% if (queuePaused) { %><li>The deployment queue is paused — new deployments will not start.</li><% } %>
    <% if (failedJobs > 0) { %><li><%= failedJobs %> failed job<%= failedJobs === 1 ? '' : 's' %> in the deployment queue.</li><% } %>
  </ul>
  <a href="/admin/server" class="button button--warning button--sm mt-2">Go to Server &amp; Queue</a>
</div>
<% } %>

<div class="stats-grid mb-6">
  <div class="stat-card">
    <span class="stat-card__value"><%= stats.totalUsers %></span>
    <span class="stat-card__label">Total Users</span>
  </div>
  <div class="stat-card">
    <span class="stat-card__value"><%= stats.activeUsers %></span>
    <span class="stat-card__label">Active Users</span>
  </div>
  <div class="stat-card">
    <span class="stat-card__value"><%= stats.totalProjects %></span>
    <span class="stat-card__label">Active Projects</span>
  </div>
  <div class="stat-card<%= stats.pendingApprovals > 0 ? ' stat-card--alert' : '' %>">
    <span class="stat-card__value"><%= stats.pendingApprovals %></span>
    <span class="stat-card__label">Pending Reviews</span>
  </div>
  <div class="stat-card<%= stats.pendingDomainApprovals > 0 ? ' stat-card--alert' : '' %>">
    <span class="stat-card__value"><%= stats.pendingDomainApprovals %></span>
    <span class="stat-card__label">Pending Domains</span>
  </div>
  <% if (server?.running !== null && server?.running !== undefined) { %>
  <div class="stat-card">
    <span class="stat-card__value"><%= server.running %></span>
    <span class="stat-card__label">Running Containers</span>
  </div>
  <% } %>
  <% if (server?.memory) { %>
  <div class="stat-card<%= server.memory.usedPercent > 85 ? ' stat-card--alert' : '' %>">
    <span class="stat-card__value"><%= server.memory.usedPercent %>%</span>
    <span class="stat-card__label">Memory Used</span>
  </div>
  <% } %>
</div>

<div class="quick-links mt-4">
  <a href="/admin/users" class="button button--secondary">Manage Users</a>
  <a href="/admin/projects" class="button button--secondary">Manage Projects</a>
  <% if (stats.pendingDomainApprovals > 0) { %>
  <a href="/admin/domains" class="button button--primary">
    Domain Queue (<%= stats.pendingDomainApprovals %>)
  </a>
  <% } else { %>
  <a href="/admin/domains" class="button button--secondary">Domain Queue</a>
  <% } %>
  <a href="/admin/server" class="button button--secondary">Server &amp; Queue</a>
  <a href="/admin/audit-events" class="button button--secondary">Audit Log</a>
  <a href="/admin/ux-metrics" class="button button--secondary">UX Metrics</a>
  <% if (stats.pendingApprovals > 0) { %>
  <a href="/admin/approval-requests" class="button button--primary">
    Review Requests (<%= stats.pendingApprovals %>)
  </a>
  <% } else { %>
  <a href="/admin/approval-requests" class="button button--secondary">Approval Requests</a>
  <% } %>
</div>

<div class="dashboard-grid mt-6">
  <section class="card" aria-labelledby="pending-work-title"><div class="card__header"><h2 class="card__title" id="pending-work-title">Pending work</h2></div><div class="card__body"><ul class="activity-list" role="list"><li><a href="/admin/approval-requests"><strong>Project reviews</strong><span><%= stats.pendingApprovals %> waiting</span></a></li><li><a href="/admin/domains"><strong>Domain reviews</strong><span><%= stats.pendingDomainApprovals %> waiting</span></a></li></ul></div></section>
  <section class="card" aria-labelledby="operations-health-title"><div class="card__header"><h2 class="card__title" id="operations-health-title">Operational health</h2></div><div class="card__body"><ul class="activity-list" role="list"><li><a href="/admin/server"><strong>Deployment worker</strong><span><%= server?.worker?.ready ? 'Ready' : 'Unavailable' %></span></a></li><li><a href="/admin/server"><strong>Queue</strong><span><%= server?.queue?.paused ? 'Paused' : server?.queue ? 'Active' : 'Unavailable' %></span></a></li><li><a href="/admin/server"><strong>Release identity</strong><span><%= server?.platformRelease?.matchesExpected ? 'Matches expected SHA' : 'Verify metadata' %></span></a></li></ul></div></section>
</div>

<section class="card mt-6" aria-labelledby="recent-admin-title"><div class="card__header"><h2 class="card__title" id="recent-admin-title">Recent admin activity</h2><a href="/admin/audit-events" class="button button--ghost button--sm">Full audit log</a></div><div class="card__body"><% if (!stats.recentActivity.length) { %><p class="text-sm text-muted">No recent admin actions.</p><% } else { %><ul class="activity-list" role="list"><% stats.recentActivity.forEach(event => { %><li><span><strong><%= event.action.replaceAll('.', ' ') %></strong><span><%= event.outcome %> · <%= new Date(event.createdAt).toLocaleString('en-GB') %></span></span></li><% }) %></ul><% } %></div></section>

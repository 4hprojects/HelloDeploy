<%
  const _prefs = preferences;
  const _hidden = new Set(_prefs.hiddenWidgets);
  const _statusLabel = { live: 'Live', degraded: 'Degraded', stale: 'Stale', offline: 'Offline' };
  const _panel = (id, title, extraClass, opts = {}) => ({ id, title, extraClass, ...opts });
  const _gridPanels = [
    _panel('trends', 'Resource trends', 'ops-panel--trends', { optional: true, cadence: 'history', subtitle: 'Range ' + _prefs.historyRange }),
    _panel('capacity', 'Capacity and allocation', 'ops-panel--capacity', { optional: true, cadence: 'resource' }),
    _panel('apps', 'Applications', 'ops-panel--apps', { optional: true, cadence: 'resource' }),
    _panel('deployments', 'Deployments and queue', 'ops-panel--deployments', { optional: true, cadence: 'resource', link: { href: '/admin/server', label: 'Server & Queue' } }),
    _panel('services', 'Platform services', 'ops-panel--services', { optional: true, cadence: 'service' }),
    _panel('attention', 'Administrative attention', 'ops-panel--attention', { optional: true, cadence: 'counts' }),
    _panel('activity', 'Recent activity', 'ops-panel--activity', { optional: true, cadence: 'counts' }),
  ];
%>
<div
  class="ops ops--<%= _prefs.density %>"
  data-ops-root
  data-live-url="/admin/overview/live"
  data-events-url="/admin/overview/events"
  data-refresh-seconds="<%= _prefs.refreshSeconds %>"
  data-resource-seconds="<%= policy.intervals.resourceSeconds %>"
  data-service-seconds="<%= policy.intervals.serviceSeconds %>"
  data-generated-at="<%= overview.generatedAt %>"
>
  <header class="ops-header">
    <div class="ops-header__title">
      <h1 class="ops-header__heading">Admin Operations</h1>
      <span class="ops-badge ops-badge--<%= overview.status %>" data-ops-status role="status" aria-live="polite"><%= _statusLabel[overview.status] || 'Unknown' %></span>
    </div>
    <div class="ops-header__actions">
      <span class="ops-header__updated">Updated <span data-ops-updated><%- include('../../partials/admin-ops/time', { at: overview.generatedAt }) %></span></span>
      <span class="ops-header__mode" data-ops-mode><%= _prefs.refreshSeconds === 0 ? 'Manual refresh' : 'Every ' + _prefs.refreshSeconds + 's' %></span>
      <button type="button" class="button button--secondary button--sm" data-ops-refresh>Refresh</button>
      <a href="/admin/overview/settings" class="button button--secondary button--sm">
        <%- include('../../partials/icon', { name: 'settings', className: 'ui-icon' }) %>
        <span>Settings</span>
      </a>
    </div>
  </header>

  <section class="ops-strip" data-ops-panel="incidents" data-ops-cadence="resource" aria-label="Active incidents">
    <%- include('../../partials/admin-ops/panel', { panel: 'incidents', overview, preferences }) %>
  </section>

  <section class="ops-kpis" data-ops-panel="kpis" data-ops-cadence="resource" aria-label="Key indicators">
    <%- include('../../partials/admin-ops/panel', { panel: 'kpis', overview, preferences }) %>
  </section>

  <div class="ops-grid">
    <% _gridPanels.filter((p) => !_hidden.has(p.id)).forEach((p) => { %>
    <section class="ops-panel <%= p.extraClass %>" aria-labelledby="ops-panel-<%= p.id %>">
      <header class="ops-panel__header">
        <h2 class="ops-panel__title" id="ops-panel-<%= p.id %>"><%= p.title %></h2>
        <% if (p.subtitle) { %><span class="ops-panel__subtitle"><%= p.subtitle %></span><% } %>
        <% if (p.link) { %><a class="ops-panel__link" href="<%= p.link.href %>"><%= p.link.label %></a><% } %>
      </header>
      <div class="ops-panel__body" data-ops-panel="<%= p.id %>" data-ops-cadence="<%= p.cadence %>">
        <%- include('../../partials/admin-ops/panel', { panel: p.id, overview, preferences }) %>
      </div>
    </section>
    <% }) %>
  </div>
  <p class="ops-live-error" data-ops-error role="alert" hidden></p>
</div>

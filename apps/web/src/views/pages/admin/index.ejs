<div class="page-header">
  <h1 class="page-header__title">Admin Overview</h1>
</div>

<%
  const workerDown = server?.worker && !server.worker.ready;
  const queuePaused = server?.queue?.paused;
  const failedJobs = server?.queue?.failed ?? 0;
  const needsAttention = workerDown || queuePaused || failedJobs > 0;
  const OUTCOMES = {
    SUCCESS: { tone: 'success', label: 'Success' },
    FAILURE: { tone: 'failed', label: 'Failed' },
    DENIED: { tone: 'suspended', label: 'Denied' },
  };
  const healthRows = [
    {
      label: 'Deployment worker',
      ...(server?.worker?.ready
        ? { tone: 'healthy', status: 'Ready' }
        : { tone: 'failed', status: 'Unavailable' }),
    },
    {
      label: 'Queue',
      ...(server?.queue?.paused
        ? { tone: 'pending', status: 'Paused' }
        : server?.queue
          ? { tone: 'healthy', status: 'Active' }
          : { tone: 'failed', status: 'Unavailable' }),
    },
    {
      label: 'Release identity',
      ...(server?.platformRelease?.matchesExpected
        ? { tone: 'healthy', status: 'Matches expected SHA' }
        : { tone: 'pending', status: 'Verify metadata' }),
    },
  ];
%>
<% if (needsAttention) { %>
<div class="alert alert--warning mb-6" role="alert">
  <div>
    <strong>Needs attention</strong>
    <ul class="mt-1">
      <% if (workerDown) { %><li>No deployment worker is connected — queued jobs will not be processed.</li><% } %>
      <% if (queuePaused) { %><li>The deployment queue is paused — new deployments will not start.</li><% } %>
      <% if (failedJobs > 0) { %><li><%= failedJobs %> failed job<%= failedJobs === 1 ? '' : 's' %> in the deployment queue.</li><% } %>
    </ul>
    <a href="/admin/server" class="button button--warning button--sm mt-2">Go to Server &amp; Queue</a>
  </div>
</div>
<% } %>

<div class="dashboard-grid mb-6">
  <section class="card" aria-labelledby="pending-work-title">
    <div class="card__header">
      <h2 class="card__title" id="pending-work-title">Pending work</h2>
    </div>
    <div class="card__body">
      <ul class="activity-list" role="list">
        <li>
          <a href="/admin/approval-requests">
            <strong>Project reviews</strong>
            <span class="status-badge status-badge--<%= stats.pendingApprovals > 0 ? 'pending' : 'neutral' %>"><%= stats.pendingApprovals %> waiting</span>
          </a>
        </li>
        <li>
          <a href="/admin/domains">
            <strong>Domain reviews</strong>
            <span class="status-badge status-badge--<%= stats.pendingDomainApprovals > 0 ? 'pending' : 'neutral' %>"><%= stats.pendingDomainApprovals %> waiting</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
  <section class="card" aria-labelledby="operations-health-title">
    <div class="card__header">
      <h2 class="card__title" id="operations-health-title">Operational health</h2>
    </div>
    <div class="card__body">
      <ul class="activity-list" role="list">
        <% healthRows.forEach(row => { %>
        <li>
          <a href="/admin/server">
            <strong><%= row.label %></strong>
            <span class="status-badge status-badge--<%= row.tone %>"><%= row.status %></span>
          </a>
        </li>
        <% }) %>
      </ul>
    </div>
  </section>
</div>

<div class="stats-grid mb-6">
  <a href="/admin/users" class="stat-card stat-card--link">
    <span class="stat-card__value"><%= stats.totalUsers %></span>
    <span class="stat-card__label">Total Users</span>
  </a>
  <a href="/admin/users?status=ACTIVE" class="stat-card stat-card--link">
    <span class="stat-card__value"><%= stats.activeUsers %></span>
    <span class="stat-card__label">Active Users</span>
  </a>
  <a href="/admin/projects" class="stat-card stat-card--link">
    <span class="stat-card__value"><%= stats.totalProjects %></span>
    <span class="stat-card__label">Active Projects</span>
  </a>
  <% if (server?.running !== null && server?.running !== undefined) { %>
  <a href="/admin/server" class="stat-card stat-card--link">
    <span class="stat-card__value"><%= server.running %></span>
    <span class="stat-card__label">Running Containers</span>
  </a>
  <% } %>
  <% if (server?.memory) { %>
  <a href="/admin/server" class="stat-card stat-card--link<%= server.memory.usedPercent > 85 ? ' stat-card--alert' : '' %>">
    <span class="stat-card__value"><%= server.memory.usedPercent %>%</span>
    <span class="stat-card__label">Memory Used</span>
  </a>
  <% } %>
</div>

<section class="card" aria-labelledby="recent-admin-title">
  <div class="card__header">
    <h2 class="card__title" id="recent-admin-title">Recent admin activity</h2>
    <a href="/admin/audit-events" class="button button--ghost button--sm">Full audit log</a>
  </div>
  <div class="card__body">
    <% if (!stats.recentActivity.length) { %>
    <p class="text-sm text-muted">No recent admin actions.</p>
    <% } else { %>
    <ul class="activity-list" role="list">
      <% stats.recentActivity.forEach(event => { %>
      <% const outcome = OUTCOMES[event.outcome] || { tone: 'neutral', label: event.outcome }; %>
      <li>
        <span>
          <strong><%= event.action.replaceAll('.', ' ') %></strong>
          <span>
            <span class="status-badge status-badge--<%= outcome.tone %>"><%= outcome.label %></span>
            <time datetime="<%= new Date(event.createdAt).toISOString() %>"><%= new Date(event.createdAt).toLocaleString('en-GB') %></time>
          </span>
        </span>
      </li>
      <% }) %>
    </ul>
    <% } %>
  </div>
</section>

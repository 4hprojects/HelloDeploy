<div class="page-header">
  <h1 class="page-header__title">Learn</h1>
  <p class="page-header__subtitle">
    Plain explanations of the things involved in putting a website online — deployment,
    hosting, domains, DNS, servers and security. Useful whether or not you use HelloDeploy.
  </p>
</div>

<% learnCategories.forEach(category => { %>
  <div class="card mt-8">
    <div class="card__body">
      <h2><%= category.heading %></h2>
      <ul class="docs__index-list">
        <% category.pages.forEach(entry => { %>
          <li>
            <a href="<%= entry.path %>"><%= entry.title %></a>
            <p class="text-sm text-muted"><%= entry.description %></p>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
<% }) %>

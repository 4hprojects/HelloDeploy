<div class="auth-form">
  <h1 class="auth-form__title">Create Account</h1>
  <p class="auth-form__subtitle">Already have an account? <a href="/auth/sign-in">Sign In</a></p>

  <aside class="alert alert--info auth-notice mb-6" aria-labelledby="account-expectations-title">
    <strong id="account-expectations-title" class="auth-notice__title">Before you start</strong>
    <ul class="auth-notice__list">
      <li>You will verify your email before entering the dashboard.</li>
      <li>Your project needs a supported GitHub repository, required configuration, and pilot approval before its first deployment.</li>
      <li>The active pilot is free within published service limits; it does not include an SLA or managed database.</li>
    </ul>
    <a href="/supported-apps" class="auth-notice__link">Check supported applications &rarr;</a>
  </aside>

  <%- include('../../partials/form-errors', { errors: typeof errors !== 'undefined' ? errors : {} }) %>

  <% if (googleAuthEnabled) { %>
  <a class="button button--secondary button--full auth-provider-button" href="/auth/google/start?intent=create-account">
    Continue with Google
  </a>
  <div class="auth-divider" role="separator"><span>or create an account with a password</span></div>
  <% } %>

  <form method="POST" action="/auth/create-account" novalidate id="create-account-form">
    <%- include('../../partials/csrf-field') %>

    <%# Honeypot — hidden from real users, bots fill it %>
    <div class="d-none" aria-hidden="true">
      <input type="text" name="website" tabindex="-1" autocomplete="off" />
    </div>

    <div class="form-row">
      <%- include('../../partials/form-field', {
        fieldId: 'firstName',
        label: 'First Name',
        type: 'text',
        name: 'firstName',
        value: typeof values !== 'undefined' ? values.firstName : '',
        autocomplete: 'given-name',
        required: true,
        error: typeof errors !== 'undefined' ? errors.firstName : null
      }) %>

      <%- include('../../partials/form-field', {
        fieldId: 'lastName',
        label: 'Last Name',
        type: 'text',
        name: 'lastName',
        value: typeof values !== 'undefined' ? values.lastName : '',
        autocomplete: 'family-name',
        required: true,
        error: typeof errors !== 'undefined' ? errors.lastName : null
      }) %>
    </div>

    <%- include('../../partials/form-field', {
      fieldId: 'email',
      label: 'Email Address',
      type: 'email',
      name: 'email',
      value: typeof values !== 'undefined' ? values.email : '',
      autocomplete: 'email',
      required: true,
      error: typeof errors !== 'undefined' ? errors.email : null
    }) %>

    <%- include('../../partials/password-field', {
      fieldId: 'password',
      fieldName: 'password',
      label: 'Password',
      required: true,
      autocomplete: 'new-password',
      error: typeof errors !== 'undefined' ? errors.password : null
    }) %>

    <%- include('../../partials/password-requirements') %>

    <%- include('../../partials/password-field', {
      fieldId: 'confirmPassword',
      fieldName: 'confirmPassword',
      label: 'Confirm Password',
      required: true,
      autocomplete: 'new-password',
      error: typeof errors !== 'undefined' ? errors.confirmPassword : null
    }) %>

    <%- include('../../partials/policy-consent', {
      error: typeof errors !== 'undefined' ? errors.acceptTerms : null
    }) %>

    <% if (turnstileSiteKey) { %>
    <div class="cf-turnstile mt-4" data-sitekey="<%= turnstileSiteKey %>" data-action="create-account"></div>
    <% } %>

    <button type="submit" class="button button--primary button--full mt-6" id="submit-btn" data-pending-label="Creating...">
      Create Account
    </button>
  </form>
</div>

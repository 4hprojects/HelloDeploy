<div class="page-header"><h1 class="page-header__title"><%= topic.title %></h1><p class="page-header__subtitle"><a href="/docs">Documentation</a> / <%= topic.title %></p></div>
<article class="card prose"><div class="card__body">
  <ul><% topic.points.forEach(point => { %><li><%= point %></li><% }) %></ul>
  <% if (topic.slug === 'supported-applications') { %><p><a href="/supported-apps" class="button button--secondary">View the full support matrix</a></p><% } %>
  <% if (topic.slug === 'service-limits') { %><p><a href="/service-limits" class="button button--secondary">View current limits</a></p><% } %>
</div></article>

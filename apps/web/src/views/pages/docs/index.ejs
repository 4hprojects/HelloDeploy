<div class="page-header"><h1 class="page-header__title">Documentation</h1><p class="page-header__subtitle">Check the workflow before creating an account.</p></div>
<div class="docs-grid">
  <% topics.forEach(([slug, label]) => { %>
  <a class="card card--link" href="/docs/<%= slug %>"><div class="card__body"><h2 class="card__title"><%= label %></h2><p class="text-sm text-muted mt-2">Read the <%= label.toLowerCase() %> guide.</p></div></a>
  <% }) %>
</div>

<div class="page-header">
  <h1 class="page-header__title">Documentation</h1>
  <p class="page-header__subtitle">
    How to configure, deploy, and manage a project on HelloDeploy.
  </p>
</div>

<% docsSections.forEach(section => { %>
  <div class="card mt-8">
    <div class="card__body">
      <h2><%= section.heading %></h2>
      <ul class="docs__index-list">
        <% section.pages.forEach(entry => { %>
          <li>
            <a href="/docs/<%= entry.slug %>"><%= entry.title %></a>
            <p class="text-sm text-muted"><%= entry.description %></p>
          </li>
        <% }) %>
      </ul>
    </div>
  </div>
<% }) %>

<%
  const runtimeLabels = {
    STATIC: 'Static website',
    REACT: 'React app',
    VUE: 'Vue app',
    NEXTJS: 'Next.js app',
    EXPRESS: 'Express app',
    NODEJS: 'Node.js app',
    UNKNOWN: 'Not recognized',
  };
  const deploymentModeLabels = {
    MANUAL: 'Manual',
    AUTOMATIC: 'Automatic',
    APPROVAL_REQUIRED: 'Approval required (legacy)',
  };
  const notificationLabels = {
    ALL: 'All deployment outcomes',
    FAILURE_ONLY: 'Failures only',
    NONE: 'None',
  };
  const deploymentStatusCopy = {
    QUEUED: 'Waiting to start',
    VALIDATING: 'Checking setup',
    BUILDING: 'Building app',
    DEPLOYING: 'Publishing',
    HEALTHY: 'Live',
    FAILED: 'Failed',
    CANCELLED: 'Cancelled',
    ROLLED_BACK: 'Replaced',
  };
%>

<div class="page-header page-header--actions">
  <div>
    <h1 class="page-header__title"><%= project.name %></h1>
    <p class="page-header__subtitle text-muted text-sm"><%= project.slug %></p>
  </div>
  <% if (membership.role === 'OWNER') { %>
  <a href="/projects/<%= project.slug %>/settings" class="button button--secondary">Settings</a>
  <% } %>
</div>

<section class="project-home-summary project-home-summary--<%= overviewState.tone %><%= overviewState.appLive ? ' project-home-summary--single' : '' %>"
  aria-labelledby="project-home-title" data-overview-phase="<%= overviewState.phase %>">
  <div class="project-home-summary__content">
    <p class="project-home-summary__eyebrow"><%= overviewState.eyebrow %></p>
    <h2 class="project-home-summary__title" id="project-home-title"><%= overviewState.title %></h2>
    <p class="project-home-summary__description"><%= overviewState.description %></p>

    <% if (overviewState.appUrl) { %>
    <a class="project-home-url" href="<%= overviewState.appUrl %>" target="_blank" rel="noopener noreferrer">
      <span class="project-home-url__label">Application address</span>
      <span class="project-home-url__value"><%= overviewState.appUrl.replace(/^https:\/\//, '') %></span>
    </a>
    <% } %>

    <% if (overviewState.primaryAction) { %>
    <div class="project-home-summary__action">
      <% if (overviewState.primaryAction.method === 'POST') { %>
      <form method="POST" action="<%= overviewState.primaryAction.href %>">
        <%- include('../../partials/csrf-field') %>
        <button type="submit" class="button button--primary"
          <% if (overviewState.primaryAction.pendingLabel) { %>data-pending-label="<%= overviewState.primaryAction.pendingLabel %>"<% } %>>
          <%= overviewState.primaryAction.label %>
        </button>
      </form>
      <% } else { %>
      <a href="<%= overviewState.primaryAction.href %>" class="button button--primary"
        <% if (overviewState.primaryAction.external) { %>target="_blank" rel="noopener noreferrer"<% } %>>
        <%= overviewState.primaryAction.label %>
      </a>
      <% } %>
    </div>
    <% } %>
  </div>

  <% if (overviewState.showMilestones !== false && !overviewState.appLive) { %>
  <ol class="project-milestones" aria-label="Steps to get the app live">
    <% overviewState.milestones.forEach((milestone, index) => { %>
    <li class="project-milestone<%= milestone.done ? ' project-milestone--done' : '' %>">
      <span class="project-milestone__number" aria-hidden="true">
        <%= milestone.done ? '✓' : index + 1 %>
      </span>
      <% if (milestone.href) { %>
      <a href="<%= milestone.href %>"<% if (milestone.done) { %> aria-label="<%= milestone.label %>, complete"<% } %>>
        <%= milestone.label %>
      </a>
      <% } else { %>
      <span><%= milestone.label %></span>
      <% } %>
    </li>
    <% }) %>
  </ol>
  <% } %>
</section>

<% if (overviewState.reviewFlag) { %>
<section class="project-home-section" aria-labelledby="review-flag-title">
  <div class="project-home-section__heading">
    <div>
      <h2 id="review-flag-title">Auto-deploy paused</h2>
      <p class="text-sm text-muted">A push was flagged for review and did not deploy automatically.</p>
    </div>
  </div>
  <ul class="approval-findings">
    <li class="approval-finding approval-finding--warning">
      <strong>Recommendation: Review the flagged change</strong>
      <span>HelloDeploy detected a high-risk file change and paused automatic deployment. Review it, then deploy manually when ready.</span>
    </li>
  </ul>
</section>
<% } %>

<% if (overviewState.attentionFindings.length > 0 && ['SETUP', 'NEEDS_ATTENTION'].includes(overviewState.phase)) { %>
<section class="project-home-section" aria-labelledby="attention-title">
  <div class="project-home-section__heading">
    <div>
      <h2 id="attention-title">What needs attention</h2>
      <p class="text-sm text-muted">Only items that need action or may improve reliability are shown.</p>
    </div>
  </div>
  <ul class="approval-findings">
    <% overviewState.attentionFindings.forEach(item => { %>
    <li class="approval-finding approval-finding--<%= item.status.toLowerCase() %>">
      <strong><%= item.status === 'BLOCKING' ? 'Fix required' : 'Recommendation' %>: <%= item.label %></strong>
      <span><%= item.message %></span>
    </li>
    <% }) %>
  </ul>
</section>
<% } %>

<% if (membership.role === 'OWNER' && latestApproval) { %>
<section class="project-home-section" id="approval-feedback" aria-labelledby="approval-title">
  <div class="project-home-section__heading">
    <div>
      <h2 id="approval-title">Project review</h2>
      <p class="text-sm text-muted">Initial approval enables this project to deploy.</p>
    </div>
    <%- include('../../partials/status-badge', { status: latestApproval.status }) %>
  </div>
  <% if (latestApproval.adminNote) { %>
  <div class="approval-note">
    <strong>Administrator note</strong>
    <p class="mt-1"><%= latestApproval.adminNote %></p>
  </div>
  <% } %>
  <% if (latestApproval.purpose) { %>
  <p class="text-sm mt-4"><strong>Application purpose:</strong> <%= latestApproval.purpose %></p>
  <% } %>
</section>
<% } %>

<% if (overviewState.canSubmit) { %>
<section class="project-home-section" id="submit-review" aria-labelledby="submit-review-title">
  <div class="project-home-section__heading">
    <div>
      <h2 id="submit-review-title"><%= latestApproval ? 'Resubmit for review' : 'Submit for review' %></h2>
      <p class="text-sm text-muted">Give the administrator a short, nontechnical description of the app.</p>
    </div>
  </div>
  <% if (approvalErrors?.form) { %><div class="alert alert--danger mb-4" role="alert"><%= approvalErrors.form %></div><% } %>
  <form method="POST" action="/projects/<%= project.slug %>/submit-review" class="project-purpose-form" novalidate>
    <%- include('../../partials/csrf-field') %>
    <div class="form-group">
      <label class="form-label" for="approval-purpose">What does this application do?</label>
      <textarea id="approval-purpose" name="purpose" rows="3" maxlength="500" required
        class="form-textarea<%= approvalErrors?.purpose ? ' form-input--error' : '' %>"
        aria-describedby="approval-purpose-hint<%= approvalErrors?.purpose ? ' approval-purpose-error' : '' %>"><%= approvalValues?.purpose || '' %></textarea>
      <p class="form-hint" id="approval-purpose-hint">Use one or two sentences. Do not include passwords or other secrets.</p>
      <% if (approvalErrors?.purpose) { %><span class="form-error" id="approval-purpose-error" role="alert"><%= approvalErrors.purpose %></span><% } %>
    </div>
    <button type="submit" class="button button--primary" data-pending-label="Submitting...">
      <%= latestApproval ? 'Resubmit for review' : 'Submit for review' %>
    </button>
  </form>
</section>
<% } %>

<% if (deployments.length > 0) { %>
<section class="project-home-section" aria-labelledby="recent-activity-title">
  <div class="project-home-section__heading">
    <div>
      <h2 id="recent-activity-title">Recent activity</h2>
      <p class="text-sm text-muted">The latest attempts to publish this app.</p>
    </div>
    <a href="/projects/<%= project.slug %>/deployments" class="button button--ghost button--sm">View all</a>
  </div>
  <ol class="project-activity-list">
    <% deployments.slice(0, 3).forEach(deployment => { %>
    <li class="project-activity">
      <div class="project-activity__main">
        <span class="project-activity__title">Deployment #<%= deployment.sequenceNumber %></span>
        <span class="project-activity__status"><%= deploymentStatusCopy[deployment.status] || deployment.status %></span>
        <% if (deployment.failureSummary) { %>
        <p class="project-activity__message"><%= deployment.failureSummary %></p>
        <% } else if (deployment.commitMessage) { %>
        <p class="project-activity__message"><%= deployment.commitMessage %></p>
        <% } %>
      </div>
      <div class="project-activity__meta">
        <span class="text-sm text-muted">
          <%= deployment.startedAt ? new Date(deployment.startedAt).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'Not started' %>
        </span>
        <a href="/projects/<%= project.slug %>/deployments/<%= deployment._id %>" class="button button--ghost button--sm">
          View details
        </a>
      </div>
    </li>
    <% }) %>
  </ol>
</section>
<% } %>

<details class="project-details-disclosure">
  <summary>
    <span>
      <strong>Project details</strong>
      <span class="text-sm text-muted">Repository, app type, deployment preferences, and optional configuration</span>
    </span>
    <span class="project-details-disclosure__toggle" aria-hidden="true">Show</span>
  </summary>
  <div class="project-details-disclosure__body">
    <dl class="project-details-grid">
      <div><dt>Project status</dt><dd><%- include('../../partials/status-badge', { status: project.status }) %></dd></div>
      <div><dt>Your role</dt><dd><span class="role-pill"><%= membership.role %></span></dd></div>
      <div><dt>Repository</dt><dd><%= repository?.fullName || 'Not connected' %></dd></div>
      <div><dt>Production branch</dt><dd><%= project.productionBranch || 'Not selected' %></dd></div>
      <div><dt>App type</dt><dd><%= runtimeLabels[project.runtimeType] || 'Not checked' %></dd></div>
      <div><dt>Deployment mode</dt><dd><%= deploymentModeLabels[project.deploymentMode] || project.deploymentMode %></dd></div>
      <div><dt>Deployment email</dt><dd><%= notificationLabels[project.notificationPreference || 'ALL'] %></dd></div>
      <div><dt>Latest source version</dt><dd><%= repository?.lastCommitSha ? repository.lastCommitSha.slice(0, 7) : 'Unavailable' %></dd></div>
    </dl>
    <div class="project-details-actions">
      <a href="/projects/<%= project.slug %>/detection" class="button button--secondary button--sm">App setup</a>
      <% if (membership.role === 'OWNER') { %>
      <a href="/projects/<%= project.slug %>/environment" class="button button--secondary button--sm">Environment variables</a>
      <a href="/projects/<%= project.slug %>/settings" class="button button--secondary button--sm">Project settings</a>
      <% } %>
    </div>
  </div>
</details>

<% if (membership.role === 'OWNER' && project.status !== 'ARCHIVED') { %>
<details class="project-details-disclosure mt-6" id="maintenance-mode">
  <summary>
    <span>
      <strong>Maintenance mode</strong>
      <span class="text-sm text-muted"><%= project.maintenanceMode?.enabled ? 'Visitors currently see the maintenance page.' : 'Temporarily replace the app with a maintenance page.' %></span>
    </span>
    <span class="status-badge status-badge--<%= project.maintenanceMode?.enabled ? 'pending' : 'healthy' %>">
      <%= project.maintenanceMode?.enabled ? 'Enabled' : 'Disabled' %>
    </span>
  </summary>
  <div class="project-details-disclosure__body">
    <% if (project.maintenanceMode?.enabled) { %>
    <% if (project.maintenanceMode.message) { %><p class="text-sm mb-4"><%= project.maintenanceMode.message %></p><% } %>
    <form method="POST" action="/projects/<%= project.slug %>/maintenance/disable"
      data-confirm="Disable maintenance mode and resume traffic to this project?"
      data-confirm-title="Disable maintenance" data-confirm-accept-label="Disable Maintenance"
      data-confirm-pending-label="Disabling..." data-confirm-variant="success">
      <%- include('../../partials/csrf-field') %>
      <button type="submit" class="button button--success">Disable maintenance</button>
    </form>
    <% } else { %>
    <form method="POST" action="/projects/<%= project.slug %>/maintenance/enable"
      data-confirm="Enable maintenance mode? Visitors will see a maintenance page instead of the app."
      data-confirm-title="Enable maintenance" data-confirm-accept-label="Enable Maintenance"
      data-confirm-pending-label="Enabling..." data-confirm-variant="warning">
      <%- include('../../partials/csrf-field') %>
      <div class="form-group mb-4">
        <label class="form-label" for="maintenance-message">Message shown to visitors <span class="text-muted">(optional)</span></label>
        <input id="maintenance-message" name="message"
          class="form-input<%= locals.maintenanceError ? ' form-input--error' : '' %>"
          value="<%= locals.maintenanceMessageValue || '' %>" maxlength="200"
          <% if (locals.maintenanceError) { %>aria-describedby="maintenance-message-error"<% } %>>
        <% if (locals.maintenanceError) { %><span id="maintenance-message-error" class="form-error" role="alert"><%= maintenanceError %></span><% } %>
      </div>
      <button type="submit" class="button button--warning">Enable maintenance</button>
    </form>
    <% } %>
  </div>
</details>
<% } %>

<% if (membership.role === 'OWNER' && project.status !== 'ARCHIVED') { %>
<div class="card card--danger mt-6">
  <div class="card__body">
    <h2 class="card__title mb-2">Danger zone</h2>
    <div class="danger-action">
      <div>
        <strong>Archive this project</strong>
        <p class="text-sm text-muted">The application will be stopped and the project will become read-only.</p>
      </div>
      <form method="POST" action="/projects/<%= project.slug %>/archive"
        data-confirm="Archive <%= project.name %>? The application will be stopped and the project will become read-only."
        data-confirm-title="Archive project" data-confirm-accept-label="Archive Project"
        data-confirm-pending-label="Archiving..." data-confirm-variant="danger">
        <%- include('../../partials/csrf-field') %>
        <button type="submit" class="button button--danger button--sm">Archive</button>
      </form>
    </div>
  </div>
</div>
<% } %>

<%
  const activeEdit = locals.activeSettingsEdit || null;
  const generalErrors = locals.settingsErrors || {};
  const bc = project.buildConfiguration || {};
  const bcErrors = locals.bcErrors || {};
  const bcValues = locals.bcValues || null;
  const bf = project.buildFilters || {};
  const bfErrors = locals.bfErrors || {};
  const bfValues = locals.bfValues || null;
  const buildCommandValue = bcValues ? (bcValues.buildCommand ?? '') : (bc.buildCommand ?? '');
  const startCommandValue = bcValues ? (bcValues.startCommand ?? '') : (bc.startCommand ?? '');
  const outputDirectoryValue = bcValues ? (bcValues.outputDirectory ?? '') : (bc.outputDirectory ?? '');
  const applicationPortValue = bcValues ? (bcValues.applicationPort ?? '') : (bc.applicationPort ?? '');
  const healthCheckPathValue = bcValues ? (bcValues.healthCheckPath ?? '') : (bc.healthCheckPath || '/');
  const deploymentModes = repository?.sourceType === 'PUBLIC_GIT' ? ['MANUAL'] : ['MANUAL', 'AUTOMATIC'];
%>

<div class="page-header page-header--actions">
  <div>
    <h1 class="page-header__title">Project Settings</h1>
    <p class="page-header__subtitle text-muted text-sm"><%= project.name %></p>
  </div>
  <a href="/projects/<%= project.slug %>" class="button button--secondary">Back to project</a>
</div>

<% if (settingsState.readOnly) { %>
<div class="alert alert--warning settings-read-only-alert mb-6" role="status">
  <strong>This project is archived.</strong>
  Settings are read-only. Permanent deletion remains available in Danger Zone.
</div>
<% } %>

<div class="project-settings-layout">
  <nav class="settings-section-nav" aria-label="Project settings sections">
    <p class="settings-section-nav__title">Settings</p>
    <ul class="settings-section-nav__list" role="list">
      <% settingsSections.forEach((section, index) => { %>
      <li>
        <a href="<%= section.href %>" class="settings-section-nav__link"
          data-settings-section-link <%= index === 0 ? 'aria-current="location"' : '' %>>
          <%= section.label %>
        </a>
      </li>
      <% }) %>
    </ul>
  </nav>

  <div class="settings-sections">
    <section class="settings-section" id="general" tabindex="-1"
      aria-labelledby="general-title" data-settings-section>
      <header class="settings-section__header">
        <div>
          <h2 id="general-title">General</h2>
          <p>Identity, lifecycle status, and platform limits.</p>
        </div>
      </header>
      <div class="settings-section__body settings-group-list">
        <div class="settings-edit-group" data-settings-edit-group
          <%= activeEdit === 'general' ? 'data-editing' : '' %>>
          <div class="settings-field-row" data-settings-display
            <%= activeEdit === 'general' ? 'hidden' : '' %>>
            <div>
              <span class="form-label">Project name</span>
              <p class="form-hint">The name shown throughout HelloDeploy.</p>
            </div>
            <div class="settings-display-row">
              <strong class="settings-display-value"><%= project.name %></strong>
              <% if (!settingsState.readOnly) { %>
              <button type="button" class="button button--secondary button--sm"
                data-settings-edit aria-label="Edit project name">Edit</button>
              <% } %>
            </div>
          </div>
          <% if (!settingsState.readOnly) { %>
          <form method="POST" action="/projects/<%= project.slug %>/update" novalidate
            data-settings-edit-form <%= activeEdit === 'general' ? '' : 'hidden' %>>
            <%- include('../../partials/csrf-field') %>
            <input type="hidden" name="returnTo"
              value="/projects/<%= project.slug %>/settings#general">
            <%- include('../../partials/form-errors', { errors: generalErrors }) %>
            <div class="settings-field-row">
              <div>
                <label class="form-label" for="settings-name">Project name</label>
                <p class="form-hint">The name shown throughout HelloDeploy.</p>
              </div>
              <div>
                <input class="form-input<%= generalErrors.name ? ' form-input--error' : '' %>"
                  id="settings-name" name="name"
                  value="<%= locals.settingsValues?.name ?? project.name %>"
                  maxlength="100" required
                  <% if (generalErrors.name) { %>aria-describedby="settings-name-error"<% } %>>
                <% if (generalErrors.name) { %>
                <span class="form-error" id="settings-name-error" role="alert"><%= generalErrors.name %></span>
                <% } %>
                <div class="form-actions mt-2">
                  <button type="button" class="button button--ghost button--sm"
                    data-settings-cancel>Cancel</button>
                  <button class="button button--primary button--sm" type="submit"
                    data-pending-label="Saving...">Save</button>
                </div>
              </div>
            </div>
          </form>
          <% } %>
        </div>

        <div class="settings-field-row">
          <div>
            <span class="form-label">Project address</span>
            <p class="form-hint">Stable identifier used in HelloDeploy links.</p>
          </div>
          <code class="code-inline settings-code-value"><%= project.slug %></code>
        </div>

        <div class="settings-field-row">
          <div>
            <span class="form-label">Project status</span>
            <p class="form-hint">Controlled by project review and platform operations.</p>
          </div>
          <div class="settings-value-start">
            <%- include('../../partials/status-badge', { status: project.status }) %>
          </div>
        </div>

        <details class="settings-advanced-disclosure">
          <summary>
            <span>
              <strong>Technical limits</strong>
              <span>Read-only capacity assigned by HelloDeploy.</span>
            </span>
            <span class="settings-advanced-disclosure__toggle" aria-hidden="true">Show</span>
          </summary>
          <div class="settings-advanced-disclosure__body">
            <dl class="settings-inline-details">
              <div><dt>Processing</dt><dd><%= quota.cpuCores %> <%= quota.cpuCores === 1 ? 'core' : 'cores' %></dd></div>
              <div><dt>Memory</dt><dd><%= quota.memoryMb %> MB</dd></div>
              <div><dt>Storage</dt><dd><%= quota.storageMb %> MB</dd></div>
              <div><dt>Build time limit</dt><dd><%= quota.buildTimeoutSeconds %> seconds</dd></div>
            </dl>
          </div>
        </details>
      </div>
    </section>

    <section class="settings-section" id="source-build" tabindex="-1"
      aria-labelledby="source-build-title" data-settings-section>
      <header class="settings-section__header">
        <div>
          <h2 id="source-build-title">App setup</h2>
          <p>Source repository and HelloDeploy's recommended build settings.</p>
        </div>
        <% if (!settingsState.readOnly) { %>
        <div class="button-group button-group--sm">
          <a href="/projects/<%= project.slug %>/repository"
            class="button button--secondary button--sm">Manage source</a>
          <a href="/projects/<%= project.slug %>/detection"
            class="button button--secondary button--sm"><%= settingsState.detection.actionLabel %></a>
        </div>
        <% } %>
      </header>
      <div class="settings-section__body settings-group-list">
        <div class="settings-field-row">
          <div>
            <span class="form-label">Repository</span>
            <p class="form-hint">Source used for app checking and deployment.</p>
          </div>
          <% if (repository) { %>
          <div class="settings-long-value">
            <strong><%= repository.fullName %></strong>
            <p class="form-hint">Production branch: <code class="code-inline"><%= project.productionBranch || 'Not selected' %></code></p>
          </div>
          <% } else { %>
          <span class="text-muted text-sm">Not connected</span>
          <% } %>
        </div>

        <div class="settings-field-row">
          <div>
            <span class="form-label">App check</span>
            <p class="form-hint"><%= settingsState.detection.description %></p>
          </div>
          <div>
            <strong><%= settingsState.detection.label %></strong>
            <p class="form-hint">App type: <%= settingsState.runtimeLabel %></p>
          </div>
        </div>

        <details class="settings-advanced-disclosure"
          <%= activeEdit === 'build-configuration' ? 'open' : '' %>>
          <summary>
            <span>
              <strong>Advanced build settings</strong>
              <span><%= settingsState.buildSummary %>. Detected values usually need no changes.</span>
            </span>
            <span class="settings-advanced-disclosure__toggle" aria-hidden="true">Show</span>
          </summary>
          <div class="settings-advanced-disclosure__body">
            <div class="settings-edit-group" data-settings-edit-group
              <%= activeEdit === 'build-configuration' ? 'data-editing' : '' %>>
              <div class="settings-field-row" data-settings-display
                <%= activeEdit === 'build-configuration' ? 'hidden' : '' %>>
                <div>
                  <span class="form-label">Recommended values</span>
                  <p class="form-hint">Only change these when the person who built the app provides different settings.</p>
                </div>
                <div class="settings-display-row">
                  <span class="settings-display-value text-sm text-muted"><%= settingsState.buildSummary %></span>
                  <% if (!settingsState.readOnly) { %>
                  <button type="button" class="button button--secondary button--sm"
                    data-settings-edit aria-label="Edit advanced build settings">Edit</button>
                  <% } %>
                </div>
              </div>
              <% if (!settingsState.readOnly) { %>
              <form method="POST" action="/projects/<%= project.slug %>/build-configuration"
                novalidate data-settings-edit-form
                <%= activeEdit === 'build-configuration' ? '' : 'hidden' %>>
                <%- include('../../partials/csrf-field') %>
                <input type="hidden" name="returnTo"
                  value="/projects/<%= project.slug %>/settings#source-build">
                <p class="text-sm text-muted mb-4">Detected values are recommended and usually require no changes.</p>
                <%- include('../../partials/form-errors', { errors: bcErrors }) %>
                <%- include('../../partials/guided-build-fields', {
                  fieldPrefix: 'settings-',
                  runtimeType: project.runtimeType,
                  configuration: bc,
                  errors: bcErrors,
                  values: bcValues,
                  includeHealthCheck: false,
                  gridClass: 'settings-form-grid',
                }) %>
                <div class="form-actions mt-4">
                  <button type="button" class="button button--ghost"
                    data-settings-cancel>Cancel</button>
                  <button type="submit" class="button button--primary"
                    data-pending-label="Saving build settings...">Save advanced settings</button>
                </div>
              </form>
              <% } %>
            </div>
          </div>
        </details>

        <details class="settings-advanced-disclosure"
          <%= activeEdit === 'build-filters' ? 'open' : '' %>>
          <summary>
            <span>
              <strong>Automatic deploy rules <span class="text-muted">(optional)</span></strong>
              <span><%= settingsState.deployRulesSummary %>. Blank means every code change can deploy.</span>
            </span>
            <span class="settings-advanced-disclosure__toggle" aria-hidden="true">Show</span>
          </summary>
          <div class="settings-advanced-disclosure__body">
            <div class="settings-edit-group" data-settings-edit-group
              <%= activeEdit === 'build-filters' ? 'data-editing' : '' %>>
              <div class="settings-field-row" data-settings-display
                <%= activeEdit === 'build-filters' ? 'hidden' : '' %>>
                <div>
                  <span class="form-label">Current rules</span>
                  <p class="form-hint">Deploying every code change is recommended for most apps.</p>
                </div>
                <div class="settings-display-row">
                  <span class="settings-display-value text-sm text-muted"><%= settingsState.deployRulesSummary %></span>
                  <% if (!settingsState.readOnly) { %>
                  <button type="button" class="button button--secondary button--sm"
                    data-settings-edit aria-label="Edit automatic deploy rules">Edit</button>
                  <% } %>
                </div>
              </div>
              <% if (!settingsState.readOnly) { %>
              <form method="POST" action="/projects/<%= project.slug %>/build-filters"
                novalidate data-settings-edit-form
                <%= activeEdit === 'build-filters' ? '' : 'hidden' %>>
                <%- include('../../partials/csrf-field') %>
                <input type="hidden" name="returnTo"
                  value="/projects/<%= project.slug %>/settings#source-build">
                <%- include('../../partials/form-errors', { errors: bfErrors }) %>
                <div class="settings-form-grid">
                  <div class="form-group">
                    <label class="form-label" for="settings-included-paths">Only deploy changes in these folders</label>
                    <textarea class="form-textarea<%= bfErrors.includedPaths ? ' form-input--error' : '' %>"
                      id="settings-included-paths" name="includedPaths" rows="3"
                      placeholder="src/**"
                      <% if (bfErrors.includedPaths) { %>aria-describedby="settings-included-paths-error"<% } %>><%= bfValues ? (bfValues.includedPaths || '') : (bf.includedPaths || []).join('\n') %></textarea>
                    <% if (bfErrors.includedPaths) { %>
                    <span class="form-error" id="settings-included-paths-error" role="alert"><%= bfErrors.includedPaths %></span>
                    <% } else { %>
                    <p class="form-hint">Leave blank to watch the whole repository.</p>
                    <% } %>
                  </div>
                  <div class="form-group">
                    <label class="form-label" for="settings-ignored-paths">Do not deploy changes in these folders</label>
                    <textarea class="form-textarea<%= bfErrors.ignoredPaths ? ' form-input--error' : '' %>"
                      id="settings-ignored-paths" name="ignoredPaths" rows="3"
                      placeholder="docs/**"
                      <% if (bfErrors.ignoredPaths) { %>aria-describedby="settings-ignored-paths-error"<% } %>><%= bfValues ? (bfValues.ignoredPaths || '') : (bf.ignoredPaths || []).join('\n') %></textarea>
                    <% if (bfErrors.ignoredPaths) { %>
                    <span class="form-error" id="settings-ignored-paths-error" role="alert"><%= bfErrors.ignoredPaths %></span>
                    <% } else { %>
                    <p class="form-hint">Leave blank unless some files should never deploy.</p>
                    <% } %>
                  </div>
                </div>
                <div class="form-actions mt-4">
                  <button type="button" class="button button--ghost"
                    data-settings-cancel>Cancel</button>
                  <button type="submit" class="button button--primary"
                    data-pending-label="Saving rules...">Save deploy rules</button>
                </div>
              </form>
              <% } %>
            </div>
          </div>
        </details>
      </div>
    </section>

    <section class="settings-section" id="deployment" tabindex="-1"
      aria-labelledby="deployment-title" data-settings-section>
      <header class="settings-section__header">
        <div>
          <h2 id="deployment-title">Deployment</h2>
          <p>Choose how releases start and manage trusted integrations.</p>
        </div>
      </header>
      <div class="settings-section__body settings-group-list">
        <div class="settings-edit-group" data-settings-edit-group>
          <div class="settings-field-row" data-settings-display>
            <div>
              <span class="form-label">How deployments start</span>
              <p class="form-hint">Manual waits for you; Automatic publishes production-branch changes.</p>
              <% if (project.deploymentMode === 'APPROVAL_REQUIRED') { %>
              <p class="form-error mt-2" role="alert">Approval Required is no longer supported. Choose Manual or Automatic.</p>
              <% } %>
            </div>
            <div class="settings-display-row">
              <strong><%= settingsState.deploymentModeLabel %></strong>
              <% if (!settingsState.readOnly) { %>
              <button type="button" class="button button--secondary button--sm"
                data-settings-edit aria-label="Edit how deployments start">Edit</button>
              <% } %>
            </div>
          </div>
          <% if (!settingsState.readOnly) { %>
          <form method="POST" action="/projects/<%= project.slug %>/deployment-mode"
            data-settings-edit-form hidden>
            <%- include('../../partials/csrf-field') %>
            <input type="hidden" name="returnTo"
              value="/projects/<%= project.slug %>/settings#deployment">
            <div class="settings-field-row">
              <div>
                <label class="form-label" for="settings-deployment-mode">How deployments start</label>
                <p class="form-hint">
                  <%= repository?.sourceType === 'PUBLIC_GIT'
                    ? 'Automatic deployments require a GitHub App connection.'
                    : project.status === 'ACTIVE'
                      ? 'Automatic deployments start after production-branch changes.'
                      : 'Automatic deployments become available after initial approval.' %>
                </p>
              </div>
              <div>
                <select class="form-select" id="settings-deployment-mode" name="deploymentMode">
                  <% deploymentModes.forEach(mode => { %>
                  <option value="<%= mode %>"
                    <%= project.deploymentMode === mode ? 'selected' : '' %>
                    <%= mode === 'AUTOMATIC' && project.status !== 'ACTIVE' ? 'disabled' : '' %>>
                    <%= mode === 'MANUAL' ? 'Manual deployments' : 'Automatic deployments' %>
                  </option>
                  <% }) %>
                </select>
                <div class="form-actions mt-2">
                  <button type="button" class="button button--ghost button--sm"
                    data-settings-cancel>Cancel</button>
                  <button type="submit" class="button button--primary button--sm"
                    data-pending-label="Saving...">Save</button>
                </div>
              </div>
            </div>
          </form>
          <% } %>
        </div>

        <div class="settings-field-row">
          <div>
            <span class="form-label">Deploy hook</span>
            <p class="form-hint">Secret address used by trusted automation tools.</p>
          </div>
          <div class="settings-display-row">
            <strong><%= settingsState.deployHookSummary %></strong>
            <% if (!settingsState.readOnly) { %>
            <a href="/projects/<%= project.slug %>/deploy-hook"
              class="button button--secondary button--sm">Manage deploy hook</a>
            <% } %>
          </div>
        </div>
      </div>
    </section>

    <section class="settings-section" id="custom-domains" tabindex="-1"
      aria-labelledby="custom-domains-title" data-settings-section>
      <header class="settings-section__header">
        <div>
          <h2 id="custom-domains-title">Custom domains</h2>
          <p>Addresses that visitors can use instead of the platform address.</p>
        </div>
        <% if (!settingsState.readOnly) { %>
        <a href="/projects/<%= project.slug %>/domains"
          class="button button--secondary button--sm">Open DNS guidance</a>
        <% } %>
      </header>
      <div class="settings-section__body settings-group-list">
        <div class="settings-field-row">
          <div>
            <span class="form-label">Configured domains</span>
            <p class="form-hint"><%= settingsState.domainSummary %> of <%= quota.maxCustomDomains %> allowed.</p>
          </div>
          <% if (domains.length) { %>
          <ul class="settings-summary-list">
            <% domains.forEach(domain => { %>
            <li>
              <span><%= domain.hostnameNormalized %></span>
              <%- include('../../partials/status-badge', { status: domain.status }) %>
            </li>
            <% }) %>
          </ul>
          <% } else { %>
          <span class="text-muted text-sm">No custom domains</span>
          <% } %>
        </div>
      </div>
    </section>

    <section class="settings-section" id="notifications" tabindex="-1"
      aria-labelledby="notifications-title" data-settings-section>
      <header class="settings-section__header">
        <div>
          <h2 id="notifications-title">Notifications</h2>
          <p>Choose which deployment results are emailed to the project Owner.</p>
        </div>
      </header>
      <div class="settings-section__body">
        <div class="settings-edit-group" data-settings-edit-group>
          <div class="settings-field-row" data-settings-display>
            <div>
              <span class="form-label">Deployment emails</span>
              <p class="form-hint">Messages go to the project Owner.</p>
            </div>
            <div class="settings-display-row">
              <strong><%= settingsState.notificationLabel %></strong>
              <% if (!settingsState.readOnly) { %>
              <button type="button" class="button button--secondary button--sm"
                data-settings-edit aria-label="Edit deployment emails">Edit</button>
              <% } %>
            </div>
          </div>
          <% if (!settingsState.readOnly) { %>
          <form method="POST" action="/projects/<%= project.slug %>/notification-preference"
            data-settings-edit-form hidden>
            <%- include('../../partials/csrf-field') %>
            <input type="hidden" name="returnTo"
              value="/projects/<%= project.slug %>/settings#notifications">
            <div class="settings-field-row">
              <div>
                <label class="form-label" for="settings-notifications">Deployment emails</label>
                <p class="form-hint">Messages go to the project Owner.</p>
              </div>
              <div>
                <select class="form-select" id="settings-notifications"
                  name="notificationPreference">
                  <option value="ALL" <%= (project.notificationPreference || 'ALL') === 'ALL' ? 'selected' : '' %>>All deployment outcomes</option>
                  <option value="FAILURE_ONLY" <%= project.notificationPreference === 'FAILURE_ONLY' ? 'selected' : '' %>>Failed deployments only</option>
                  <option value="NONE" <%= project.notificationPreference === 'NONE' ? 'selected' : '' %>>No deployment emails</option>
                </select>
                <div class="form-actions mt-2">
                  <button type="button" class="button button--ghost button--sm"
                    data-settings-cancel>Cancel</button>
                  <button type="submit" class="button button--primary button--sm"
                    data-pending-label="Saving...">Save</button>
                </div>
              </div>
            </div>
          </form>
          <% } %>
        </div>
      </div>
    </section>

    <section class="settings-section" id="health-maintenance" tabindex="-1"
      aria-labelledby="health-maintenance-title" data-settings-section>
      <header class="settings-section__header">
        <div>
          <h2 id="health-maintenance-title">Availability</h2>
          <p>How HelloDeploy confirms a release works and handles planned downtime.</p>
        </div>
      </header>
      <div class="settings-section__body settings-group-list">
        <details class="settings-advanced-disclosure"
          <%= activeEdit === 'health-check' ? 'open' : '' %>>
          <summary>
            <span>
              <strong>Working-page check</strong>
              <span>HelloDeploy checks <%= bc.healthCheckPath || '/' %> before sending visitors to a release.</span>
            </span>
            <span class="settings-advanced-disclosure__toggle" aria-hidden="true">Show</span>
          </summary>
          <div class="settings-advanced-disclosure__body">
            <div class="settings-edit-group" data-settings-edit-group
              <%= activeEdit === 'health-check' ? 'data-editing' : '' %>>
              <div class="settings-field-row" data-settings-display
                <%= activeEdit === 'health-check' ? 'hidden' : '' %>>
                <div>
                  <span class="form-label">Path</span>
                  <p class="form-hint">The page must respond successfully before a release becomes live.</p>
                </div>
                <div class="settings-display-row">
                  <code class="code-inline"><%= bc.healthCheckPath || '/' %></code>
                  <% if (!settingsState.readOnly) { %>
                  <button type="button" class="button button--secondary button--sm"
                    data-settings-edit aria-label="Edit working-page check">Edit</button>
                  <% } %>
                </div>
              </div>
              <% if (!settingsState.readOnly) { %>
              <form method="POST" action="/projects/<%= project.slug %>/build-configuration"
                novalidate data-settings-edit-form
                <%= activeEdit === 'health-check' ? '' : 'hidden' %>>
                <%- include('../../partials/csrf-field') %>
                <input type="hidden" name="returnTo"
                  value="/projects/<%= project.slug %>/settings#health-maintenance">
                <input type="hidden" name="buildCommand" value="<%= buildCommandValue %>">
                <input type="hidden" name="startCommand" value="<%= startCommandValue %>">
                <input type="hidden" name="outputDirectory" value="<%= outputDirectoryValue %>">
                <input type="hidden" name="applicationPort" value="<%= applicationPortValue %>">
                <%- include('../../partials/form-errors', { errors: bcErrors }) %>
                <div class="settings-field-row">
                  <div>
                    <label class="form-label" for="settings-health-path">Working-page path</label>
                    <p class="form-hint">Use a path such as <code class="code-inline">/</code> or <code class="code-inline">/health</code>.</p>
                  </div>
                  <div>
                    <input class="form-input<%= bcErrors.healthCheckPath ? ' form-input--error' : '' %>"
                      id="settings-health-path" name="healthCheckPath"
                      value="<%= healthCheckPathValue %>" maxlength="255" required
                      <% if (bcErrors.healthCheckPath) { %>aria-describedby="settings-health-path-error"<% } %>>
                    <% if (bcErrors.healthCheckPath) { %>
                    <span class="form-error" id="settings-health-path-error"
                      role="alert"><%= bcErrors.healthCheckPath %></span>
                    <% } %>
                    <div class="form-actions mt-2">
                      <button type="button" class="button button--ghost button--sm"
                        data-settings-cancel>Cancel</button>
                      <button type="submit" class="button button--primary button--sm"
                        data-pending-label="Saving...">Save</button>
                    </div>
                  </div>
                </div>
              </form>
              <% } %>
            </div>
          </div>
        </details>

        <div class="settings-field-row">
          <div>
            <span class="form-label">Maintenance page</span>
            <p class="form-hint">Temporarily replace the app while planned work is underway.</p>
          </div>
          <div class="settings-display-row">
            <strong><%= settingsState.maintenanceSummary %></strong>
            <% if (!settingsState.readOnly) { %>
            <a href="/projects/<%= project.slug %>#maintenance-mode"
              class="button button--secondary button--sm">Manage on overview</a>
            <% } %>
          </div>
        </div>
      </div>
    </section>

    <section class="settings-section settings-section--danger" id="danger-zone"
      tabindex="-1" aria-labelledby="danger-zone-title" data-settings-section>
      <header class="settings-section__header">
        <div>
          <h2 id="danger-zone-title">Danger Zone</h2>
          <p>Actions that stop or permanently remove this project.</p>
        </div>
      </header>
      <div class="settings-section__body settings-group-list">
        <% if (!settingsState.readOnly) { %>
        <div class="danger-action">
          <div>
            <strong>Archive project</strong>
            <p class="text-sm text-muted">Stops the app and makes project settings read-only.</p>
          </div>
          <form method="POST" action="/projects/<%= project.slug %>/archive"
            data-confirm="Archive <%= project.name %>? The application will be stopped and the project will become read-only."
            data-confirm-title="Archive project" data-confirm-accept-label="Archive Project"
            data-confirm-pending-label="Archiving..." data-confirm-variant="danger">
            <%- include('../../partials/csrf-field') %>
            <input type="hidden" name="returnTo"
              value="/projects/<%= project.slug %>/settings#danger-zone">
            <button type="submit" class="button button--danger button--sm">Archive</button>
          </form>
        </div>
        <% } %>

        <div class="danger-action">
          <div>
            <strong>Delete project permanently</strong>
            <p class="text-sm text-muted">Deletes deployments, domains, secrets, and member access. This cannot be undone.</p>
          </div>
          <form method="POST" action="/projects/<%= project.slug %>/delete"
            data-confirm="Permanently delete <%= project.name %> and all project data?"
            data-confirm-title="Delete project" data-confirm-accept-label="Delete Project"
            data-confirm-pending-label="Deleting..." data-confirm-variant="danger">
            <%- include('../../partials/csrf-field') %>
            <input type="hidden" name="returnTo"
              value="/projects/<%= project.slug %>/settings#danger-zone">
            <label class="form-label" for="settings-confirm-slug">
              Type <code class="code-inline"><%= project.slug %></code> to confirm
            </label>
            <div class="settings-field-row__control">
              <input class="form-input" id="settings-confirm-slug" name="confirmSlug"
                autocomplete="off" required>
              <button type="submit" class="button button--danger button--sm">Delete</button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </div>
</div>

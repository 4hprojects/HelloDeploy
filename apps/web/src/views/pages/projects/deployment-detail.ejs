<div class="page-header page-header--actions" data-deployment-refresh="header">
  <div>
    <h1 class="page-header__title">
      Deployment #<%= deployment.sequenceNumber %>
      <span data-detail-status><%- include('../../partials/status-badge', { status: deployment.status, statusKind: 'deployment' }) %></span>
    </h1>
    <p class="page-header__subtitle text-muted text-sm">
      <a href="/projects/<%= project.slug %>/deployments" class="table-link">&larr; All Deployments</a>
    </p>
  </div>
  <% const canAct = membership.role === 'OWNER' || membership.role === 'MAINTAINER'; %>
  <% const isActive = ['QUEUED','VALIDATING','BUILDING','DEPLOYING'].includes(deployment.status); %>
  <% const isRetryable = ['FAILED','CANCELLED'].includes(deployment.status); %>
  <div class="button-group" data-terminal-actions>
    <% if (isActive && canAct) { %>
    <form method="POST" action="/projects/<%= project.slug %>/deployments/<%= deployment._id %>/cancel"
          data-confirm="Stop this deployment? Completed build work will be discarded and the current live release will remain unchanged."
          data-confirm-title="Cancel deployment"
          data-confirm-accept-label="Cancel Deployment"
          data-confirm-pending-label="Cancelling..."
          data-confirm-variant="danger">
      <%- include('../../partials/csrf-field') %>
      <button type="submit" class="button button--danger button--sm" data-tooltip="Cancel this deployment before it completes.">Cancel</button>
    </form>
    <% } %>
    <% if (isRetryable && canAct) { %>
    <form method="POST" action="/projects/<%= project.slug %>/deployments/<%= deployment._id %>/retry" data-confirm="Retry recorded commit <%= deployment.commitSha.slice(0, 7) %> with current configuration and build cache?">
      <%- include('../../partials/csrf-field') %>
      <input type="hidden" name="source" value="same"><button type="submit" class="button button--secondary button--sm" data-pending-label="Retrying...">Retry same commit</button>
    </form>
    <form method="POST" action="/projects/<%= project.slug %>/deployments/<%= deployment._id %>/retry" data-confirm="Resolve the latest production-branch commit and deploy it with current configuration and build cache?">
      <%- include('../../partials/csrf-field') %><input type="hidden" name="source" value="latest"><button type="submit" class="button button--ghost button--sm" data-pending-label="Resolving...">Retry latest</button>
    </form>
    <% } %>
  </div>
</div>

<div data-deployment-refresh="result" class="alert alert--<%= deployment.status === 'HEALTHY' ? 'success' : deployment.status === 'FAILED' ? 'error' : 'info' %> mb-6" role="status" data-deployment-result data-status-url="/projects/<%= project.slug %>/deployments/<%= deployment._id %>/status" data-terminal="<%= !isActive %>">
  <strong><%= deployment.status === 'HEALTHY' ? 'Deployment completed successfully.' : deployment.status === 'FAILED' ? 'Deployment did not go live.' : deployment.status === 'CANCELLED' ? 'Deployment was cancelled.' : 'Deployment is in progress.' %></strong>
  <p class="text-sm mt-1"><%= isCurrentRelease ? 'This is the release currently serving the platform URL.' : project.activeDeploymentId ? 'Another healthy deployment is currently serving traffic.' : 'No healthy release is currently live.' %></p>
</div>

<!-- Deployment info cards -->
<div class="card-grid card-grid--3 mb-6" data-deployment-refresh="summary">
  <div class="card">
    <div class="card__body">
      <p class="text-muted text-xs mb-1">Commit</p>
      <code class="code-inline"><%= deployment.commitSha ? deployment.commitSha.slice(0, 7) : '—' %></code>
      <% if (deployment.commitMessage) { %>
      <p class="text-sm mt-1"><%= deployment.commitMessage.slice(0, 80) %></p>
      <% } %>
    </div>
  </div>
  <div class="card">
    <div class="card__body">
      <p class="text-muted text-xs mb-1">Trigger</p>
      <p class="text-sm font-medium"><%= deployment.triggerType %></p>
      <% if (deployment.sourceDeploymentId) { %>
      <p class="text-muted text-xs">Rollback from current release to target <%= rollbackSource ? `#${rollbackSource.sequenceNumber} (${rollbackSource.commitSha.slice(0, 7)})` : deployment.sourceDeploymentId %></p>
      <% } %>
    </div>
  </div>
  <div class="card">
    <div class="card__body">
      <p class="text-muted text-xs mb-1">Duration</p>
      <% if (deployment.startedAt && deployment.completedAt) { %>
        <% const ms = new Date(deployment.completedAt) - new Date(deployment.startedAt); %>
        <% const secs = Math.round(ms / 1000); %>
      <p class="text-sm font-medium" data-detail-duration><%= secs < 60 ? `${secs}s` : `${Math.floor(secs/60)}m ${secs%60}s` %></p>
      <% } else if (deployment.startedAt) { %>
        <p class="text-sm font-medium text-muted" data-detail-duration data-started-at="<%= new Date(deployment.startedAt).toISOString() %>">In progress…</p>
      <% } else { %>
        <p class="text-sm text-muted">—</p>
      <% } %>
    </div>
  </div>
</div>

<!-- Stage timeline -->
<div class="card mb-6" data-deployment-refresh="timeline">
  <div class="card__header">
    <h2 class="card__title text-sm">Deployment Timeline</h2>
  </div>
  <div class="card__body">
    <%
      const terminalStatuses = ['FAILED','CANCELLED','HEALTHY','ROLLED_BACK'];
      const eventStageToStatus = { VALIDATE: 'VALIDATING', BUILD: 'BUILDING', DEPLOY: 'DEPLOYING' };
      const statusOrder = { QUEUED: 0, VALIDATING: 1, BUILDING: 2, DEPLOYING: 3, HEALTHY: 4, FAILED: 4, CANCELLED: 4, ROLLED_BACK: 4 };
      const timelineStages = [
        { key: 'QUEUED', label: 'Queued', detail: 'Waiting for a deployment worker.', eventStages: [] },
        { key: 'VALIDATING', label: 'Validate', detail: 'Repository, build context, and Dockerfile checks.', eventStages: ['VALIDATE'] },
        { key: 'BUILDING', label: 'Build', detail: 'Container image build and artifact preparation.', eventStages: ['BUILD'] },
        { key: 'DEPLOYING', label: 'Deploy', detail: 'Container startup, health checks, and routing.', eventStages: ['DEPLOY'] },
        { key: 'HEALTHY', label: 'Healthy', detail: 'Release is live and serving traffic.', eventStages: ['DEPLOY'] },
      ];
      const eventsForStage = (stage) => events.filter((ev) => stage.eventStages.includes(ev.stage));
      const firstEventForStage = (stage) => eventsForStage(stage)[0] ?? null;
      const latestEventForStage = (stage) => eventsForStage(stage).slice(-1)[0] ?? null;
      const latestErrorEvent = events.filter((ev) => ev.level === 'ERROR').slice(-1)[0] ?? null;
      const failedStageKey = latestErrorEvent ? eventStageToStatus[latestErrorEvent.stage] : deployment.status;
      const currentOrder = statusOrder[deployment.status] ?? 0;
      const isTerminalStatus = terminalStatuses.includes(deployment.status);
      const failedStageOrder = statusOrder[failedStageKey] ?? currentOrder;
      const stageStarts = {
        QUEUED: deployment.startedAt,
        VALIDATING: firstEventForStage(timelineStages[1])?.createdAt ?? null,
        BUILDING: firstEventForStage(timelineStages[2])?.createdAt ?? null,
        DEPLOYING: firstEventForStage(timelineStages[3])?.createdAt ?? null,
        HEALTHY: deployment.status === 'HEALTHY' ? deployment.completedAt : null,
      };
      const stageState = (stage) => {
        const order = statusOrder[stage.key] ?? 0;
        if (['FAILED','CANCELLED','ROLLED_BACK'].includes(deployment.status)) {
          if (stage.key === failedStageKey) return 'failed';
          return order < failedStageOrder ? 'complete' : 'pending';
        }
        if (deployment.status === 'HEALTHY' && stage.key === 'HEALTHY') return 'complete';
        if (!isTerminalStatus && stage.key === deployment.status) return 'active';
        if (order < currentOrder) return 'complete';
        return 'pending';
      };
      const formatElapsed = (secs) => secs < 60 ? `${secs}s` : `${Math.floor(secs / 60)}m ${secs % 60}s`;
      const formatStamp = (date) => new Date(date).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
      // A stage ends where the next stage that actually ran begins, or when the deployment finished.
      const stageEnd = (index) => timelineStages.slice(index + 1)
        .map((later) => stageStarts[later.key])
        .find(Boolean) ?? deployment.completedAt;
      const stageMeta = (stage, index, state) => {
        if (state === 'pending') return '—';
        if (state === 'active') return 'Running';
        if (state === 'failed') return statusPresentation('deployment', deployment.status).label;
        if (stage.key === 'HEALTHY') return 'Live';
        const start = stageStarts[stage.key];
        const end = stageEnd(index);
        if (!start || !end) return 'Done';
        return formatElapsed(Math.max(0, Math.round((new Date(end) - new Date(start)) / 1000)));
      };
      const statusText = { pending: 'Pending', active: 'In progress', complete: 'Complete' };
      const activeStage = timelineStages.find((stage) => stageState(stage) === 'active');
      const failedStage = timelineStages.find((stage) => stageState(stage) === 'failed');
      const detail = activeStage
        ? {
            label: activeStage.label,
            time: stageStarts[activeStage.key],
            message: latestEventForStage(activeStage)?.messageRedacted ?? activeStage.detail,
          }
        : failedStage
          ? {
              label: failedStage.label,
              time: deployment.completedAt,
              message: latestErrorEvent?.messageRedacted ?? failedStage.detail,
            }
          : deployment.status === 'HEALTHY'
            ? { label: 'Healthy', time: deployment.completedAt, message: timelineStages[4].detail }
            : null;
    %>
    <ol class="deploy-stepper" aria-label="Deployment progress">
      <% timelineStages.forEach((stage, i) => { %>
        <% const state = stageState(stage); %>
        <li class="deploy-step deploy-step--<%= state %>" data-stage-key="<%= stage.key %>"
          data-stage-started-at="<%= stageStarts[stage.key] ? new Date(stageStarts[stage.key]).toISOString() : '' %>">
          <span class="deploy-step__icon" aria-hidden="true">
            <%- include('../../partials/icon', { name: 'check', className: 'deploy-step__glyph deploy-step__glyph--complete' }) %>
            <%- include('../../partials/icon', { name: 'x', className: 'deploy-step__glyph deploy-step__glyph--failed' }) %>
            <span class="deploy-step__glyph deploy-step__glyph--active deploy-step__spinner"></span>
            <span class="deploy-step__glyph deploy-step__glyph--pending"><%= i + 1 %></span>
          </span>
          <span class="deploy-step__label"><%= stage.label %></span>
          <span class="deploy-step__meta" data-stage-meta><%= stageMeta(stage, i, state) %></span>
          <span class="sr-only" data-stage-status><%= statusText[state] ?? statusPresentation('deployment', deployment.status).label %></span>
        </li>
      <% }) %>
    </ol>
    <div class="deploy-stepper__detail" aria-live="polite"<%= detail ? '' : ' hidden' %> data-stage-detail>
      <p class="deploy-stepper__detail-heading">
        <strong data-stage-detail-label><%= detail?.label ?? '' %></strong>
        <time class="text-muted" data-stage-detail-time><%= detail?.time ? formatStamp(detail.time) : '' %></time>
      </p>
      <p class="deploy-stepper__detail-message" data-stage-detail-message><%= detail?.message ?? '' %></p>
    </div>
    <% if (deployment.failureCode && failureCopy) { %>
    <div class="alert alert--error mt-4">
      <strong><%= failureCopy.message %></strong>
      <p class="text-sm mt-1"><%= failureCopy.action %></p>
    </div>
    <details class="guided-disclosure mt-4">
      <summary class="guided-disclosure__summary">
        <span>
          <span class="guided-disclosure__title">Technical details</span>
          <span class="guided-disclosure__description">
            For the person who built the app, or for support.
          </span>
        </span>
        <span class="guided-disclosure__toggle" aria-hidden="true">Show</span>
      </summary>
      <div class="guided-disclosure__body">
        <p class="text-sm"><strong><%= deployment.failureCode %></strong></p>
        <% if (deployment.failureSummary) { %>
        <p class="text-sm mt-1"><%= deployment.failureSummary %></p>
        <% } %>
      </div>
    </details>
    <% } %>
  </div>
</div>

<!-- Log viewer -->
<div class="card" id="log-card">
  <div class="card__header">
    <h2 class="card__title text-sm">Deployment Logs</h2>
    <div class="button-group button-group--sm">
      <label class="form-label sr-only" for="log-search">Search visible logs</label><input class="form-input form-input--sm" id="log-search" type="search" placeholder="Search logs" data-log-search>
      <button type="button" class="button button--ghost button--sm" data-log-follow aria-pressed="true">Following live</button>
      <button type="button" class="button button--ghost button--sm" data-log-copy>Copy visible</button>
      <a class="button button--ghost button--sm" href="/projects/<%= project.slug %>/deployments/<%= deployment._id %>/logs/download">Download</a>
    </div>
    <span data-deployment-refresh="log-status">
      <% if (!['FAILED','CANCELLED','HEALTHY','ROLLED_BACK'].includes(deployment.status)) { %>
      <span class="badge badge--building text-xs" id="live-indicator">● Live</span>
      <button type="button" class="button button--ghost button--sm d-none" id="log-reconnect-button">Reconnect</button>
      <% } %>
    </span>
  </div>
  <div class="card__body p-0">
    <div
      class="log-viewer"
      id="log-output"
      aria-live="polite"
      aria-label="Deployment logs"
      <% if (!['FAILED','CANCELLED','HEALTHY','ROLLED_BACK'].includes(deployment.status)) { %>
      data-stream-url="/projects/<%= project.slug %>/deployments/<%= deployment._id %>/logs"
      <% } %>
    >
      <% if (events.length === 0 && ['QUEUED','VALIDATING'].includes(deployment.status)) { %>
      <div class="log-line log-line--info">Waiting for worker to pick up job…</div>
      <% } %>
      <% events.forEach(ev => { %>
      <div class="log-line log-line--<%= ev.level.toLowerCase() %>">
        <span class="log-line__stage"><%= ev.stage %></span>
        <span class="log-line__msg"><%= ev.messageRedacted %></span>
      </div>
      <% }) %>
    </div>
  </div>
</div>

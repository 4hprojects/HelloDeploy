<div class="page-header page-header--actions">
  <div>
    <h1 class="page-header__title">
      Deployment #<%= deployment.sequenceNumber %>
      <%- include('../../partials/status-badge', { status: deployment.status }) %>
    </h1>
    <p class="page-header__subtitle text-muted text-sm">
      <a href="/projects/<%= project.slug %>/deployments" class="table-link">&larr; All Deployments</a>
    </p>
  </div>
  <% const canAct = membership.role === 'OWNER' || membership.role === 'MAINTAINER'; %>
  <% const isActive = ['QUEUED','VALIDATING','BUILDING','DEPLOYING'].includes(deployment.status); %>
  <% const isRetryable = ['FAILED','CANCELLED'].includes(deployment.status); %>
  <div class="button-group">
    <% if (isActive && canAct) { %>
    <form method="POST" action="/projects/<%= project.slug %>/deployments/<%= deployment._id %>/cancel"
          data-confirm="Cancel this deployment before it completes?"
          data-confirm-title="Cancel deployment"
          data-confirm-accept-label="Cancel Deployment"
          data-confirm-pending-label="Cancelling..."
          data-confirm-variant="danger">
      <%- include('../../partials/csrf-field') %>
      <button type="submit" class="button button--danger button--sm" data-tooltip="Cancel this deployment before it completes.">Cancel</button>
    </form>
    <% } %>
    <% if (isRetryable && canAct) { %>
    <form method="POST" action="/projects/<%= project.slug %>/deployments/<%= deployment._id %>/retry">
      <%- include('../../partials/csrf-field') %>
      <button type="submit" class="button button--secondary button--sm" data-pending-label="Retrying..." data-tooltip="Queue another deployment attempt for this commit.">Retry</button>
    </form>
    <% } %>
  </div>
</div>

<!-- Deployment info cards -->
<div class="card-grid card-grid--3 mb-6">
  <div class="card">
    <div class="card__body">
      <p class="text-muted text-xs mb-1">Commit</p>
      <code class="code-inline"><%= deployment.commitSha ? deployment.commitSha.slice(0, 7) : '—' %></code>
      <% if (deployment.commitMessage) { %>
      <p class="text-sm mt-1"><%= deployment.commitMessage.slice(0, 80) %></p>
      <% } %>
    </div>
  </div>
  <div class="card">
    <div class="card__body">
      <p class="text-muted text-xs mb-1">Trigger</p>
      <p class="text-sm font-medium"><%= deployment.triggerType %></p>
      <% if (deployment.sourceDeploymentId) { %>
      <p class="text-muted text-xs">from deployment #<%= deployment.sourceDeploymentId %></p>
      <% } %>
    </div>
  </div>
  <div class="card">
    <div class="card__body">
      <p class="text-muted text-xs mb-1">Duration</p>
      <% if (deployment.startedAt && deployment.completedAt) { %>
        <% const ms = new Date(deployment.completedAt) - new Date(deployment.startedAt); %>
        <% const secs = Math.round(ms / 1000); %>
        <p class="text-sm font-medium"><%= secs < 60 ? `${secs}s` : `${Math.floor(secs/60)}m ${secs%60}s` %></p>
      <% } else if (deployment.startedAt) { %>
        <p class="text-sm font-medium text-muted">In progress…</p>
      <% } else { %>
        <p class="text-sm text-muted">—</p>
      <% } %>
    </div>
  </div>
</div>

<!-- Progress -->
<div class="card mb-6">
  <div class="card__header">
    <h2 class="card__title text-sm">
      <% if (progress.isFinished) { %>Your website is published<% } else if (progress.failedStage) { %>Publishing stopped<% } else { %>Publishing your website<% } %>
    </h2>
  </div>
  <div class="card__body">
    <ol class="deploy-progress" role="list" aria-live="polite" data-deploy-progress>
      <% progress.steps.forEach((step) => { %>
      <li
        class="deploy-progress__step deploy-progress__step--<%= step.status.toLowerCase() %>"
        data-progress-stage="<%= step.stage %>"
      >
        <span class="deploy-progress__marker" aria-hidden="true">
          <% if (step.status === 'COMPLETE') { %>&check;<% } else if (step.status === 'ACTIVE') { %>&bull;<% } else if (step.status === 'FAILED') { %>&times;<% } else if (step.status === 'STOPPED') { %>&ndash;<% } else { %>&#9675;<% } %>
        </span>
        <span class="deploy-progress__body">
          <span class="deploy-progress__label">
            <%= step.label %>
            <span class="sr-only"> — <%= step.statusWord %></span>
          </span>
          <span class="deploy-progress__description"><%= step.description %></span>
        </span>
        <span class="deploy-progress__time text-muted">
          <% if (step.completedAt) { %>
            <%= new Date(step.completedAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %>
          <% } else if (step.startedAt) { %>
            <%= new Date(step.startedAt).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' }) %>
          <% } %>
        </span>
      </li>
      <% }) %>
    </ol>

    <% if (progress.isFinished) { %>
    <div class="button-group mt-6">
      <a href="/projects/<%= project.slug %>/setup/published" class="button button--primary button--sm">
        See your live website
      </a>
    </div>
    <% } %>

    <% if (deployment.failureCode && failureCopy) { %>
    <div class="alert alert--error mt-6" role="alert">
      <strong><%= failureCopy.message %></strong>
      <p class="text-sm mt-1"><%= failureCopy.action %></p>
    </div>

    <div class="button-group mt-4">
      <%# Gated here as well as in the controller: a viewer must never be shown
          an action they cannot perform, whatever the caller passes in. %>
      <% if (canAct) { %>
        <% recoveryActions.forEach((action) => { %>
          <% if (action.method === 'POST') { %>
          <form method="POST" action="<%= action.href %>">
            <%- include('../../partials/csrf-field') %>
            <button type="submit" class="button button--primary button--sm" data-pending-label="Starting...">
              <%= action.label %>
            </button>
          </form>
          <% } else { %>
          <a href="<%= action.href %>" class="button button--secondary button--sm"><%= action.label %></a>
          <% } %>
        <% }) %>
      <% } %>
    </div>

    <% if (uiMode === 'ADVANCED') { %>
    <div class="deploy-technical mt-4">
      <p class="text-sm"><strong><%= deployment.failureCode %></strong></p>
      <% if (deployment.failureSummary) { %>
      <p class="text-sm mt-1"><%= deployment.failureSummary %></p>
      <% } %>
    </div>
    <% } else { %>
    <details class="guided-disclosure mt-4">
      <summary class="guided-disclosure__summary">
        <span>
          <span class="guided-disclosure__title">Technical details</span>
          <span class="guided-disclosure__description">
            For the person who built the app, or for support.
          </span>
        </span>
        <span class="guided-disclosure__toggle" aria-hidden="true">Show</span>
      </summary>
      <div class="guided-disclosure__body">
        <p class="text-sm"><strong><%= deployment.failureCode %></strong></p>
        <% if (deployment.failureSummary) { %>
        <p class="text-sm mt-1"><%= deployment.failureSummary %></p>
        <% } %>
      </div>
    </details>
    <% } %>
    <% } %>
  </div>
</div>

<!-- Technical logs: available, but not the default reading -->
<% const isStreaming = !['FAILED','CANCELLED','HEALTHY','ROLLED_BACK'].includes(deployment.status); %>
<details class="card log-disclosure" id="log-card" <%= isStreaming ? 'open' : '' %>>
  <summary class="card__header log-disclosure__summary">
    <h2 class="card__title text-sm">View technical logs</h2>
    <% if (isStreaming) { %>
    <span class="badge badge--building text-xs" id="live-indicator">&bull; Live</span>
    <button type="button" class="button button--ghost button--sm d-none" id="log-reconnect-button">Reconnect</button>
    <% } %>
  </summary>
  <div class="card__body p-0">
    <div
      class="log-viewer"
      id="log-output"
      aria-label="Deployment logs"
      <% if (isStreaming) { %>
      data-stream-url="/projects/<%= project.slug %>/deployments/<%= deployment._id %>/logs"
      <% } %>
    >
      <% if (events.length === 0 && ['QUEUED','VALIDATING'].includes(deployment.status)) { %>
      <div class="log-line log-line--info">Waiting for a worker to pick this up…</div>
      <% } %>
      <% events.forEach(ev => { %>
      <div class="log-line log-line--<%= ev.level.toLowerCase() %>">
        <span class="log-line__stage"><%= ev.stage %></span>
        <span class="log-line__msg"><%= ev.messageRedacted %></span>
      </div>
      <% }) %>
    </div>
  </div>
</details>

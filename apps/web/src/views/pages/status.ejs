<div class="page-header"><h1 class="page-header__title">Service Status</h1><p class="page-header__subtitle">Current pilot readiness; this is not an uptime history or SLA.</p></div>
<div class="card"><div class="card__body status-summary status-summary--<%= operational ? 'healthy' : 'attention' %>"><h2><%= operational ? 'All checked systems operational' : 'Service disruption detected' %></h2><p><%= operational ? 'The public application and its required platform dependencies are responding.' : 'One or more required platform dependencies did not pass the latest readiness check.' %></p><p class="text-sm text-muted mt-2">Checked <time datetime="<%= checkedAt.toISOString() %>"><%= checkedAt.toLocaleString('en-GB', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit', timeZoneName: 'short' }) %></time></p></div></div>

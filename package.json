{
  "name": "hellodeploy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "concurrently --names \"web,worker\" --prefix-colors \"cyan,yellow\" \"npm run dev -w @hellodeploy/web\" \"npm run dev -w @hellodeploy/worker\"",
    "start": "concurrently --names \"web,worker\" \"npm run start -w @hellodeploy/web\" \"npm run start -w @hellodeploy/worker\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:build": "node scripts/build-assets.js",
    "assets:verify": "node scripts/verify-assets.js",
    "assets:budget": "node scripts/check-ui-budgets.js",
    "database:indexes:verify": "node scripts/verify-product-event-indexes.js",
    "users:status:repair": "node scripts/repair-legacy-user-status.js",
    "email:index:repair": "node scripts/repair-email-verification-index.js",
    "config:check": "node scripts/validate-config.js",
    "host:baseline": "node scripts/capture-host-baseline.js",
    "production:check": "node scripts/check-public-production.js",
    "test": "node scripts/run-tests.js",
    "test:watch": "node scripts/run-tests.js --watch",
    "test:coverage": "node scripts/run-tests.js --coverage",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "previews:capture": "node scripts/capture-product-previews.js",
    "performance:lab": "node scripts/run-lighthouse-lab.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "concurrently": "^8.2.2",
    "eslint": "^9.18.0",
    "lighthouse": "^13.5.0",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "allowScripts": {
    "argon2@0.41.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
